        echo '<path d="M15.6 4.4a2.1 2.1 0 0 1 3 3L8.25 17.75l-4 1 1-4z"/><path d="M13.75 6.25l3 3"/>'
      when 'download'
        echo '<path d="M12 3.75v11"/><path d="M7.75 10.75L12 15l4.25-4.25"/><path d="M4.75 19.75h14.5"/>'
      when 'arrows-horizontal'
        echo '<path d="M3 12h18"/><path d="m7 8-4 4 4 4"/><path d="m17 8 4 4-4 4"/>'
      when 'volume-off'
        echo '<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="m16 9.5 5 5"/><path d="m21 9.5-5 5"/>'
      when 'volume-on'
        echo '<path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M15.5 9a4.5 4.5 0 0 1 0 6"/><path d="M18 6.5a8 8 0 0 1 0 11"/>'
      when 'spoon'
        echo '<path d="M12 3.5c2.1 0 3.5 2 3.5 4.4 0 2.1-1.15 3.6-2.5 4.1v8.5a1 1 0 0 1-2 0V12c-1.35-.5-2.5-2-2.5-4.1C8.5 5.5 9.9 3.5 12 3.5z"/>'
    endcase
  endcapture
-%}
