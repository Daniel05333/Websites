{%- doc -%}
  Premium inline-SVG art shown until the merchant uploads photography: volcanic gradient,
  LavaCell™ hexagon relief, ember glow and a fine line-art silhouette per type.

  @param {string} [type] - hero | product | lifestyle | macro | collection | chef | problem | wok | set | knife | pot | board
  @param {string} [class] - Extra classes.
  @param {string} [label] - Accessible label.

  @example
  {% render 'vk-placeholder', type: 'hero' %}
{%- enddoc -%}
{%- liquid
  assign vk_t = type | default: 'product'
  assign vk_vb = '0 0 1600 1600'
  assign vk_cx = 800
  assign vk_cy = 760
  case vk_t
    when 'hero', 'lifestyle', 'macro', 'collection', 'chef'
      assign vk_vb = '0 0 1600 900'
      assign vk_cx = 1060
      assign vk_cy = 470
    when 'problem'
      assign vk_vb = '0 0 1200 900'
      assign vk_cx = 600
      assign vk_cy = 450
  endcase
-%}
<svg class="vk-placeholder vk-placeholder--{{ vk_t }}{% if class %} {{ class }}{% endif %}" viewBox="{{ vk_vb }}" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ label | default: shop.name | escape }}">
  <defs>
    <radialGradient id="vkp-bg-{{ vk_t }}" cx="{{ vk_cx }}" cy="{{ vk_cy }}" r="1100" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#211A18"/><stop offset=".45" stop-color="#121212"/><stop offset="1" stop-color="#060606"/>
    </radialGradient>
    <radialGradient id="vkp-glow-{{ vk_t }}" cx="{{ vk_cx }}" cy="{{ vk_cy | plus: 120 }}" r="520" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#FF4B32" stop-opacity=".42"/><stop offset=".55" stop-color="#D7261E" stop-opacity=".12"/><stop offset="1" stop-color="#D7261E" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="vkp-ti-{{ vk_t }}" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#E9E6E2"/><stop offset=".35" stop-color="#8E8A86"/><stop offset=".6" stop-color="#C9C5C0"/><stop offset="1" stop-color="#4A4846"/>
    </linearGradient>
    <linearGradient id="vkp-rim-{{ vk_t }}" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#FF4B32" stop-opacity="0"/><stop offset=".7" stop-color="#FF4B32" stop-opacity=".0"/><stop offset="1" stop-color="#FF6A3D" stop-opacity=".9"/>
    </linearGradient>
    <pattern id="vkp-hex-{{ vk_t }}" width="28" height="48.5" patternUnits="userSpaceOnUse" patternTransform="scale(1.2)">
      <path d="M14 0l14 8.08v16.17L14 32.33 0 24.25V8.08z M14 32.33v16.17" fill="none" stroke="#F7F5F2" stroke-opacity=".09" stroke-width="1.2"/>
    </pattern>
    <clipPath id="vkp-clip-{{ vk_t }}"><circle cx="{{ vk_cx }}" cy="{{ vk_cy }}" r="300"/></clipPath>
  </defs>
  <rect width="100%" height="100%" fill="url(#vkp-bg-{{ vk_t }})"/>
  <rect width="100%" height="100%" fill="url(#vkp-glow-{{ vk_t }})"/>
  {%- case vk_t -%}
    {%- when 'macro' -%}
      <rect width="100%" height="100%" fill="url(#vkp-hex-{{ vk_t }})" opacity="1"/>
      <rect width="100%" height="100%" fill="url(#vkp-hex-{{ vk_t }})" transform="translate(14 24)" opacity=".7"/>
      <ellipse cx="{{ vk_cx }}" cy="{{ vk_cy }}" rx="620" ry="260" fill="url(#vkp-glow-{{ vk_t }})"/>
    {%- when 'knife' -%}
      <g transform="translate(800 800) rotate(-34)">
        <path d="M-520 -18 L300 -46 Q420 -40 470 0 Q420 22 300 26 L-520 26 Z" fill="url(#vkp-ti-{{ vk_t }})" opacity=".92"/>
        <path d="M-520 -18 L300 -46 Q420 -40 470 0" fill="none" stroke="url(#vkp-rim-{{ vk_t }})" stroke-width="3"/>
        <rect x="-560" y="-24" width="22" height="56" rx="4" fill="#D7261E"/>
        <rect x="-860" y="-30" width="300" height="68" rx="26" fill="#141414" stroke="#F7F5F2" stroke-opacity=".12"/>
      </g>
    {%- when 'wok' -%}
      <ellipse cx="{{ vk_cx }}" cy="{{ vk_cy | plus: 300 }}" rx="420" ry="40" fill="#000" opacity=".55"/>
      <path d="M380 700 Q800 1180 1220 700 Z" fill="#191919" stroke="#F7F5F2" stroke-opacity=".1"/>
      <ellipse cx="800" cy="700" rx="420" ry="120" fill="url(#vkp-ti-{{ vk_t }})" opacity=".35"/>
      <ellipse cx="800" cy="700" rx="420" ry="120" fill="url(#vkp-hex-{{ vk_t }})"/>
      <ellipse cx="800" cy="700" rx="420" ry="120" fill="none" stroke="url(#vkp-rim-{{ vk_t }})" stroke-width="6"/>
      <path d="M1210 690 L1500 610" stroke="#8E8A86" stroke-width="26" stroke-linecap="round"/><circle cx="1228" cy="686" r="16" fill="#D7261E"/>
    {%- when 'set' -%}
      {%- for r in (1..3) -%}
        {%- assign vk_r = r | times: 70 | plus: 140 -%}{%- assign vk_x = r | times: 330 | plus: 140 -%}
        <g transform="translate({{ vk_x }} {{ 920 | minus: vk_r }})">
          <circle r="{{ vk_r }}" fill="#171717" stroke="#F7F5F2" stroke-opacity=".12" stroke-width="3"/>
          <circle r="{{ vk_r | minus: 22 }}" fill="url(#vkp-ti-{{ vk_t }})" opacity=".32"/>
          <circle r="{{ vk_r | minus: 22 }}" fill="url(#vkp-hex-{{ vk_t }})"/>
          <path d="M{{ vk_r | times: 0.7 }} {{ vk_r | times: 0.7 }} l160 160" stroke="#8E8A86" stroke-width="20" stroke-linecap="round"/>
        </g>
      {%- endfor -%}
    {%- when 'chef', 'lifestyle' -%}
      <rect x="0" y="640" width="1600" height="260" fill="#0B0B0B"/>
      <ellipse cx="{{ vk_cx }}" cy="600" rx="230" ry="44" fill="url(#vkp-ti-{{ vk_t }})" opacity=".55"/>
      <path d="M{{ vk_cx }} 560 C{{ vk_cx | minus: 120 }} 420 {{ vk_cx | plus: 40 }} 360 {{ vk_cx | minus: 20 }} 160 C{{ vk_cx | plus: 120 }} 300 {{ vk_cx | plus: 160 }} 430 {{ vk_cx }} 560Z" fill="#FF4B32" opacity=".55"/>
      <path d="M{{ vk_cx }} 560 C{{ vk_cx | minus: 60 }} 470 {{ vk_cx | plus: 10 }} 420 {{ vk_cx }} 300 C{{ vk_cx | plus: 70 }} 400 {{ vk_cx | plus: 80 }} 480 {{ vk_cx }} 560Z" fill="#FFB27A" opacity=".55"/>
    {%- when 'problem' -%}
      <circle cx="600" cy="450" r="300" fill="#1B1B1B" stroke="#F7F5F2" stroke-opacity=".08" stroke-width="4"/>
      <circle cx="600" cy="450" r="270" fill="#242322"/>
      <path d="M470 360 l60 40 -30 50 70 30 M660 520 l40 -60 50 20 M560 600 l50 -30" stroke="#8A6B5E" stroke-width="5" fill="none" stroke-linecap="round"/>
      <ellipse cx="640" cy="420" rx="90" ry="60" fill="#3A2A22" opacity=".8"/>
    {%- else -%}
      <ellipse cx="{{ vk_cx }}" cy="{{ vk_cy | plus: 330 }}" rx="360" ry="40" fill="#000" opacity=".6"/>
      <circle cx="{{ vk_cx }}" cy="{{ vk_cy }}" r="330" fill="#171717" stroke="#F7F5F2" stroke-opacity=".12" stroke-width="4"/>
      <circle cx="{{ vk_cx }}" cy="{{ vk_cy }}" r="300" fill="url(#vkp-ti-{{ vk_t }})" opacity=".3"/>
      <circle cx="{{ vk_cx }}" cy="{{ vk_cy }}" r="300" fill="url(#vkp-hex-{{ vk_t }})"/>
      <circle cx="{{ vk_cx }}" cy="{{ vk_cy }}" r="330" fill="none" stroke="url(#vkp-rim-{{ vk_t }})" stroke-width="6"/>
      <path d="M{{ vk_cx | plus: 230 }} {{ vk_cy | plus: 230 }} L{{ vk_cx | plus: 560 }} {{ vk_cy | plus: 520 }}" stroke="#8E8A86" stroke-width="34" stroke-linecap="round"/>
      <circle cx="{{ vk_cx | plus: 250 }}" cy="{{ vk_cy | plus: 248 }}" r="22" fill="#D7261E"/>
  {%- endcase -%}
</svg>
