{%- doc -%}
  Offer bar for the ad landing template (product.metalen-spatel). Mirrors the cream bar under the ad creatives:
  "Nu tot X% korting" + promise line + red "Bestel nu" button.
  X is calculated from the product's real compare-at prices (highest saving of all variants, rounded down).
  When no variant has a compare-at price, `fallback` is shown instead of the deal line (or nothing).
  Only used by the vk-lp-* sections; no other template renders it.

  @param {object} product - The product.
  @param {string} [deal] - Deal line, `[korting]` is replaced by the percentage. Default 'Nu tot [korting]% korting'.
  @param {string} [fallback] - Shown when there is no compare-at price.
  @param {string} [sub] - Line under the deal. Default: shipping + returns promises from theme settings.
  @param {string} [button_label] - Default 'Bestel nu'.
  @param {string} [button_url] - Default '#buy' (the buy box of the main product section).
  @param {boolean} [show_price] - Show "vanaf" price of the cheapest available variant.
  @param {string} [class] - Extra classes.

  @example
  {% render 'vk-lp-offer-bar', product: product, deal: s.deal %}
{%- enddoc -%}
{%- liquid
  assign vk_lp_off = 0
  assign vk_lp_cheap = nil
  for vk_lp_v in product.variants
    if vk_lp_v.compare_at_price > vk_lp_v.price
      assign vk_lp_d = vk_lp_v.compare_at_price | minus: vk_lp_v.price | times: 100 | divided_by: vk_lp_v.compare_at_price | floor
      if vk_lp_d > vk_lp_off
        assign vk_lp_off = vk_lp_d
      endif
    endif
    if vk_lp_v.available
      if vk_lp_cheap == nil
        assign vk_lp_cheap = vk_lp_v
      elsif vk_lp_v.price < vk_lp_cheap.price
        assign vk_lp_cheap = vk_lp_v
      endif
    endif
  endfor
  if vk_lp_cheap == nil
    assign vk_lp_cheap = product.selected_or_first_available_variant
  endif

  assign vk_lp_deal = ''
  if vk_lp_off > 0
    assign vk_lp_pct = vk_lp_off | append: ''
    assign vk_lp_deal = deal | default: 'Nu tot [korting]% korting' | replace: '[korting]', vk_lp_pct
  elsif fallback != blank
    assign vk_lp_deal = fallback
  endif

  if sub != blank
    assign vk_lp_sub = sub
  else
    assign vk_lp_sub = ''
    if settings.promise_shipping != blank
      assign vk_lp_sub = settings.promise_shipping
    endif
    if settings.promise_trial != blank
      if vk_lp_sub != blank
        assign vk_lp_sub = vk_lp_sub | append: ' · '
      endif
      assign vk_lp_sub = vk_lp_sub | append: settings.promise_trial
    endif
  endif
-%}
<div class="vk-lp-bar{% if class %} {{ class }}{% endif %}">
  <div class="vk-lp-bar__copy">
    {%- if vk_lp_deal != blank %}<p class="vk-lp-bar__deal">{{ vk_lp_deal | escape }}</p>{% endif -%}
    {%- if show_price -%}
      <p class="vk-lp-bar__price">
        {%- if product.price_varies %}<span class="vk-lp-bar__from">{{ 'products.product.price.from' | t }}</span> {% endif -%}
        <strong>{{ vk_lp_cheap.price | money }}</strong>
        {%- if vk_lp_cheap.compare_at_price > vk_lp_cheap.price %} <s><span class="vk-visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{{ vk_lp_cheap.compare_at_price | money }}</s>{% endif -%}
      </p>
    {%- endif -%}
    {%- if vk_lp_sub != blank %}<p class="vk-lp-bar__sub">{{ vk_lp_sub | escape }}</p>{% endif -%}
  </div>
  <a href="{{ button_url | default: '#buy' }}" class="vk-lp-btn">
    <span>{{ button_label | default: 'Bestel nu' | escape }}</span>
    {%- render 'vk-icon', name: 'arrow-right', size: 18 -%}
  </a>
</div>
