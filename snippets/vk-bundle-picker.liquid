{%- doc -%}
  Honest bundle tiers. Compact cards: only the selected tier expands. Tier 1 = selected variant; tiers 2 and 3 can let the customer pick a size per pan (vk-bundle-pick); otherwise tier 2 = a second bundle product, or the selected variant + add-on (matched by size);
  tier 3 = a dedicated bundle product. Prices and savings are real (from compare_at or sum of parts).
  @param {object} block - bundle_picker block.
  @param {object} product - Current product.
  @param {object} variant - Selected variant.
  @param {string} section_id - Section id.
  @param {boolean} [nest_variants] - Render the size options inside the first tier.
  @param {string} [size_help] - Size helper line for the nested options.
  @example
  {% render 'vk-bundle-picker', block: block, product: product, variant: vk_v, section_id: section.id %}
{%- enddoc -%}
{%- liquid
  assign b = block.settings
  assign vk_addon = b.t2_addon
  assign vk_addon_v = nil
  for av in vk_addon.variants
    if av.option1 == variant.option1
      assign vk_addon_v = av
      break
    endif
  endfor
  assign vk_t2_price = variant.price | plus: vk_addon_v.price
  assign vk_t2 = b.t2_product
  assign vk_t2_v = vk_t2.selected_or_first_available_variant
  assign vk_t3 = b.t3_product
  assign vk_t3_v = vk_t3.selected_or_first_available_variant
  # "Pick your sizes" tiers need a product with a single option (size).
  assign vk_can_pick = false
  if product.options.size == 1 and product.has_only_default_variant == false
    assign vk_can_pick = true
  endif
  assign vk_t2_pick = 0
  assign vk_t3_pick = 0
  if vk_can_pick
    assign vk_t2_pick = b.t2_pick | default: 0
    assign vk_t3_pick = b.t3_pick | default: 0
  endif
-%}
<vk-bundle-picker class="vk-pdp__block vk-bundles" data-section="{{ section_id }}" {{ block.shopify_attributes }}>
  <script type="application/json" data-bundle-json>
    {
      "addon": {% if vk_addon != blank %}{ "variants": [{% for av in vk_addon.variants %}{ "id": {{ av.id }}, "option1": {{ av.option1 | json }}, "price": {{ av.price }}, "available": {{ av.available }} }{% unless forloop.last %},{% endunless %}{% endfor %}] }{% else %}null{% endif %},
      "bundle2": {% if vk_t2 != blank %}{ "id": {{ vk_t2_v.id }}, "price": {{ vk_t2_v.price }}, "compare": {{ vk_t2_v.compare_at_price | default: 0 }}, "available": {{ vk_t2_v.available }} }{% else %}null{% endif %},
      "bundle": {% if vk_t3 != blank %}{ "id": {{ vk_t3_v.id }}, "price": {{ vk_t3_v.price }}, "compare": {{ vk_t3_v.compare_at_price | default: 0 }}, "available": {{ vk_t3_v.available }} }{% else %}null{% endif %}
    }
  </script>
  <p class="vk-eyebrow vk-bundles__label" id="vk-bundles-label-{{ section_id }}">{{ b.label }}</p>
  <div class="vk-bundles__list" role="radiogroup" aria-labelledby="vk-bundles-label-{{ section_id }}">
    <div class="vk-bundle is-active" data-tier-card="single" data-tier-name="{{ b.t1_title | escape }}">
      <label class="vk-bundle__head">
        <input type="radio" name="vk-bundle-{{ section_id }}" value="single" checked data-tier-input aria-describedby="vk-bt1-{{ section_id }}">
        <span class="vk-bundle__radio" aria-hidden="true"></span>
        <span class="vk-bundle__title">{{ b.t1_title }}</span>
        <span class="vk-bundle__price"><span data-tier-price="single">{{ variant.price | money }}</span><s data-tier-compare="single"{% unless variant.compare_at_price > variant.price %} hidden{% endunless %}>{{ variant.compare_at_price | money }}</s></span>
      </label>
      <div class="vk-bundle__panel"><div class="vk-bundle__inner">
        {%- if b.t1_text != blank %}<p class="vk-bundle__text" id="vk-bt1-{{ section_id }}">{{ b.t1_text }}</p>{% endif -%}
        {%- if nest_variants -%}{% render 'vk-variant-options', product: product, section_id: section_id, size_help: size_help, style: b.size_style %}{%- endif -%}
      </div></div>
    </div>
    {%- if vk_t2_pick > 1 -%}
      {%- render 'vk-bundle-pick', key: 'pick2', count: vk_t2_pick, discount: b.t2_discount, title: b.t2_title, tag: b.t2_tag, text: b.t2_text, product: product, section_id: section_id, ember: false -%}
    {%- elsif vk_t2 != blank and vk_t2.id != product.id -%}
      {%- render 'vk-bundle-tier', key: 'bundle2', title: b.t2_title, tag: b.t2_tag, text: b.t2_text, items: b.t2_items, tier_product: vk_t2, tier_variant: vk_t2_v, section_id: section_id, ember: false -%}
    {%- elsif vk_addon != blank -%}
      <div class="vk-bundle" data-tier="addon" data-tier-card="addon" data-tier-name="{{ b.t2_title | escape }}"{% if vk_addon_v == nil %} hidden{% endif %}>
        <label class="vk-bundle__head">
          <input type="radio" name="vk-bundle-{{ section_id }}" value="addon" data-tier-input aria-describedby="vk-bt2-{{ section_id }}">
          <span class="vk-bundle__radio" aria-hidden="true"></span>
          <span class="vk-bundle__title">{{ b.t2_title }}{% if b.t2_tag != blank %} <span class="vk-bundle__tag">{{ b.t2_tag }}</span>{% endif %}</span>
          <span class="vk-bundle__price"><span data-tier-price="addon">{% if vk_addon_v != nil %}{{ vk_t2_price | money }}{% endif %}</span></span>
        </label>
        <div class="vk-bundle__panel"><div class="vk-bundle__inner">
          {%- if b.t2_text != blank %}<p class="vk-bundle__text" id="vk-bt2-{{ section_id }}">{{ b.t2_text }}</p>{% endif -%}
        </div></div>
      </div>
    {%- endif -%}
    {%- if vk_t3_pick > 1 -%}
      {%- render 'vk-bundle-pick', key: 'pick3', count: vk_t3_pick, discount: b.t3_discount, title: b.t3_title, tag: b.t3_tag, text: b.t3_text, product: product, section_id: section_id, ember: true -%}
    {%- elsif vk_t3 != blank and vk_t3.id != product.id -%}
      {%- render 'vk-bundle-tier', key: 'bundle', title: b.t3_title, tag: b.t3_tag, text: b.t3_text, items: b.t3_items, tier_product: vk_t3, tier_variant: vk_t3_v, section_id: section_id, ember: true -%}
    {%- endif -%}
  </div>
</vk-bundle-picker>
