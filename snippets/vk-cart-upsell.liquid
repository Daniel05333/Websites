{%- doc -%}
  Cart upsell: settings.cart_upsell_product, else the first bestseller not already in the cart.
  @param {object} cart - Cart.
  @example
  {% render 'vk-cart-upsell', cart: cart %}
{%- enddoc -%}
{%- liquid
  assign vk_in_cart = cart.items | map: 'product_id'
  assign vk_up = settings.cart_upsell_product
  if vk_up != blank and vk_in_cart contains vk_up.id
    assign vk_up = nil
  endif
  if vk_up == blank
    for p in collections['bestsellers'].products limit: 8
      unless vk_in_cart contains p.id
        if p.available
          assign vk_up = p
          break
        endif
      endunless
    endfor
  endif
-%}
{%- if vk_up != blank and cart.item_count > 0 -%}
  <div class="vk-upsell">
    <p class="vk-eyebrow">{{ 'cart.upsell_heading' | t }}</p>
    <div class="vk-upsell__card">
      <a href="{{ vk_up.url }}" class="vk-upsell__media vk-media vk-ratio-square">
        {%- if vk_up.featured_image -%}{{ vk_up.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: vk_up.title }}{%- else -%}{% render 'vk-placeholder', type: 'product' %}{%- endif -%}
      </a>
      <div class="vk-upsell__info">
        <a href="{{ vk_up.url }}" class="vk-upsell__title">{{ vk_up.title | escape }}</a>
        {% render 'vk-price', product: vk_up, show_save: false %}
      </div>
      <vk-product-form>
        {%- form 'product', vk_up, class: 'vk-upsell__form' -%}
          <input type="hidden" name="id" value="{{ vk_up.selected_or_first_available_variant.id }}">
          <button type="submit" class="vk-icon-btn" aria-label="{{ 'products.card.add_variant' | t: variant: vk_up.title }}">{% render 'vk-icon', name: 'plus', size: 18 %}</button>
          <p data-form-error role="alert" hidden></p>
        {%- endform -%}
      </vk-product-form>
    </div>
  </div>
{%- endif -%}
