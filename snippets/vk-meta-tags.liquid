{%- doc -%}
  Open Graph + Twitter/X card tags for every page type (the layouts print the canonical link and description).

  @example
  {% render 'vk-meta-tags' %}
{%- enddoc -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    when 'password'
      assign og_url = request.origin
  endcase

  assign x_handle = blank
  if settings.social_x_link != blank
    assign x_handle = settings.social_x_link | split: '?' | first | split: '/' | last | remove: '@' | strip
    if x_handle != blank
      assign x_handle = x_handle | prepend: '@'
    endif
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | strip_html | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | escape }}">
{%- if page_image %}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  {%- if page_image.alt != blank %}
    <meta property="og:image:alt" content="{{ page_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}
{%- if request.page_type == 'product' and product %}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
{%- if x_handle != blank %}
  <meta name="twitter:site" content="{{ x_handle | escape }}">
{%- endif %}
<meta name="twitter:title" content="{{ og_title | strip_html | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | escape }}">
