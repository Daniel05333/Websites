{%- doc -%}
  One product media item (image, video, external video, 3D model).
  @param {object} media - Media object.
  @param {string} [loading] - 'eager' | 'lazy'.
  @param {string} [sizes] - Image sizes.
  @example
  {% render 'vk-product-media', media: media %}
{%- enddoc -%}
{%- case media.media_type -%}
  {%- when 'image' -%}
    {%- if loading == 'eager' -%}
      {{ media | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: sizes, widths: '550,750,1100,1500,1800', alt: media.alt, class: 'vk-pmedia__img' }}
    {%- else -%}
      {{ media | image_url: width: 1800 | image_tag: loading: 'lazy', sizes: sizes, widths: '550,750,1100,1500,1800', alt: media.alt, class: 'vk-pmedia__img' }}
    {%- endif -%}
  {%- when 'video' -%}
    <vk-video class="vk-pmedia__video">{{ media | video_tag: muted: true, loop: true, playsinline: true, controls: true, preload: 'metadata', image_size: '1500x' }}</vk-video>
  {%- when 'external_video' -%}
    <div class="vk-pmedia__embed">{{ media | external_video_tag: loading: 'lazy' }}</div>
  {%- when 'model' -%}
    <div class="vk-pmedia__model">{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true, data-model-id: media.id }}</div>
  {%- else -%}
    {{ media | media_tag }}
{%- endcase -%}
