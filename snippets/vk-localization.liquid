{%- doc -%}
  Country/currency and language selectors (Shopify localization form). Auto-submits on change.
  @param {string} [id] - Unique prefix.
  @param {string} [class] - Extra classes.
  @example
  {% render 'vk-localization', id: 'header' %}
{%- enddoc -%}
{%- liquid
  assign vk_show_country = false
  if settings.show_currency_selector and localization.available_countries.size > 1
    assign vk_show_country = true
  endif
  assign vk_show_lang = false
  if settings.show_language_selector and localization.available_languages.size > 1
    assign vk_show_lang = true
  endif
-%}
{%- if vk_show_country or vk_show_lang -%}
  {%- form 'localization', id: id | append: '-localization', class: 'vk-localization' -%}
    {%- if vk_show_country -%}
      <label class="vk-visually-hidden" for="{{ id }}-country">{{ 'localization.country_label' | t }}</label>
      <select id="{{ id }}-country" name="country_code" class="vk-localization__select" onchange="this.form.submit()">
        {%- for country in localization.available_countries -%}
          <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})</option>
        {%- endfor -%}
      </select>
    {%- endif -%}
    {%- if vk_show_lang -%}
      <label class="vk-visually-hidden" for="{{ id }}-language">{{ 'localization.language_label' | t }}</label>
      <select id="{{ id }}-language" name="locale_code" class="vk-localization__select" onchange="this.form.submit()">
        {%- for language in localization.available_languages -%}
          <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
        {%- endfor -%}
      </select>
    {%- endif -%}
    <noscript><button type="submit" class="vk-btn vk-btn--secondary vk-btn--sm">{{ 'localization.update' | t }}</button></noscript>
  {%- endform -%}
{%- endif -%}
