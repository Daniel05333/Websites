{%- doc -%}
  Image for the vk-lp-* sections: the merchant's uploaded image, else a bundled asset of this landing page.
  Only used by the vk-lp-* sections.

  @param {object} [image] - Image picked in the theme editor.
  @param {string} [fallback] - Asset filename, e.g. 'vk-lp-pan-top.webp'. Used when no image is picked.
  @param {number} [fallback_width] - Intrinsic width of the asset.
  @param {number} [fallback_height] - Intrinsic height of the asset.
  @param {string} [alt] - Alt text.
  @param {string} [sizes] - sizes attribute.
  @param {boolean} [eager] - Load eagerly with high fetch priority (hero only).
  @param {string} [class] - Class for the img.

  @example
  {% render 'vk-lp-media', image: s.image, fallback: 'vk-lp-pan-top.webp', fallback_width: 880, fallback_height: 674, eager: true %}
{%- enddoc -%}
{%- liquid
  assign vk_lp_sizes = sizes | default: '(min-width: 990px) 50vw, 100vw'
  assign vk_lp_alt = alt | default: image.alt | escape
-%}
{%- if image != blank -%}
  {%- if eager -%}
    {{ image | image_url: width: 1600 | image_tag: sizes: vk_lp_sizes, widths: '480,720,960,1200,1600', class: class, loading: 'eager', fetchpriority: 'high', alt: vk_lp_alt }}
  {%- else -%}
    {{ image | image_url: width: 1600 | image_tag: sizes: vk_lp_sizes, widths: '480,720,960,1200,1600', class: class, loading: 'lazy', alt: vk_lp_alt }}
  {%- endif -%}
{%- elsif fallback != blank -%}
  <img src="{{ fallback | asset_url }}" alt="{{ vk_lp_alt }}" width="{{ fallback_width }}" height="{{ fallback_height }}"{% if class %} class="{{ class }}"{% endif %}{% if eager %} loading="eager" fetchpriority="high"{% else %} loading="lazy"{% endif %} decoding="async">
{%- endif -%}
