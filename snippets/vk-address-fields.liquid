{%- doc -%}
  Address form fields.
  @param {object} form - customer_address form.
  @param {string} id - Unique suffix.
  @example
  {% render 'vk-address-fields', form: form, id: 'new' %}
{%- enddoc -%}
<div class="vk-contact__grid">
  <div class="vk-field"><label class="vk-label" for="a-first-{{ id }}">{{ 'customer.first_name' | t }}</label><input class="vk-input" id="a-first-{{ id }}" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
  <div class="vk-field"><label class="vk-label" for="a-last-{{ id }}">{{ 'customer.last_name' | t }}</label><input class="vk-input" id="a-last-{{ id }}" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
  <div class="vk-field vk-contact__full"><label class="vk-label" for="a-a1-{{ id }}">{{ 'customer.addresses.address1' | t }}</label><input class="vk-input" id="a-a1-{{ id }}" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
  <div class="vk-field vk-contact__full"><label class="vk-label" for="a-a2-{{ id }}">{{ 'customer.addresses.address2' | t }}</label><input class="vk-input" id="a-a2-{{ id }}" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
  <div class="vk-field"><label class="vk-label" for="a-zip-{{ id }}">{{ 'customer.addresses.zip' | t }}</label><input class="vk-input" id="a-zip-{{ id }}" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
  <div class="vk-field"><label class="vk-label" for="a-city-{{ id }}">{{ 'customer.addresses.city' | t }}</label><input class="vk-input" id="a-city-{{ id }}" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
  <div class="vk-field"><label class="vk-label" for="a-country-{{ id }}">{{ 'customer.addresses.country' | t }}</label><select class="vk-select" id="a-country-{{ id }}" name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select></div>
  <div class="vk-field"><label class="vk-label" for="a-phone-{{ id }}">{{ 'customer.addresses.phone' | t }}</label><input class="vk-input" id="a-phone-{{ id }}" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
</div>
<label class="vk-checkbox">{{ form.set_as_default_checkbox }}<span>{{ 'customer.addresses.set_default' | t }}</span></label>
