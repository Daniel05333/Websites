      "type": "vk-reviews",
      "settings": {
        "index": "08",
        "eyebrow": "Reviews",
        "heading": "Trusted by kitchens that <em>cook daily</em>.",
        "subheading": "What home cooks say after the first sear — and the hundredth.",
