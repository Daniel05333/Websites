    "faq": {
      "type": "vk-faq",
      "blocks": {
        "q-1": {
          "type": "question",
          "settings": {
            "question": "Waarin verschilt titanium van een plastic plank?",
            "answer": "<p>Een plastic plank krijgt groeven waarin vocht en resten blijven zitten, en kan kleine deeltjes afgeven. Onze plank is van 100% puur titanium: glad, niet-poreus en zonder coating.</p>"
          }
        },
        "q-2": {
          "type": "question",
          "settings": {
            "question": "Is titanium veilig om op te snijden?",
            "answer": "<p>Ja. Er zit geen PFAS of coating op, en het oppervlak neemt geen vocht, geuren of vlekken op.</p>"
          }
        },
        "q-3": {
          "type": "question",
          "settings": {
            "question": "Worden mijn messen er bot van?",
            "answer": "<p>Een harde plank maakt een snijkant sneller bot dan hout. Zet je messen daarom regelmatig aan; dan blijven ze scherp.</p>"
          }
        },
        "q-4": {
          "type": "question",
          "settings": {
            "question": "Neemt de plank geuren of vlekken op?",
            "answer": "<p>Nee. Titanium is niet-poreus: na vis, knoflook of rode biet spoel je hem af en is hij weer schoon.</p>"
          }
        },
        "q-5": {
          "type": "question",
          "settings": {
            "question": "Mag de plank in de vaatwasser?",
            "answer": "<p>De plank is eenvoudig met de hand schoon te maken: warm water, een beetje afwasmiddel en afdrogen. Zo blijft hij het mooist.</p>"
          }
        },
        "q-6": {
          "type": "question",
          "settings": {
            "question": "Hoe lang kan ik de plank gebruiken?",
            "answer": "<p>Bij normaal gebruik jarenlang: er is geen coating die kan slijten, en je krijgt 25 jaar garantie.</p>"
          }
        },
        "q-7": {
          "type": "question",
          "settings": {
            "question": "Is de plank zwaar?",
            "answer": "<p>Nee. Titanium is licht en dun, maar uitzonderlijk sterk. Daardoor is de plank makkelijk te hanteren en op te bergen.</p>"
          }
        },
        "q-8": {
          "type": "question",
          "settings": {
            "question": "Heeft de plank onderhoud nodig?",
            "answer": "<p>Nee. Anders dan hout hoeft titanium niet geolied te worden. Afspoelen en afdrogen is genoeg.</p>"
          }
        }
      },
