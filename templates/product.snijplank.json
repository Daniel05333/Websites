      "blocks": {
        "q-1": {
          "type": "question",
          "settings": {
            "question": "Wat is het verschil met een plastic snijplank?",
            "answer": "<p>Een plastic plank krijgt groeven door je mes, waarin vocht en etensresten blijven zitten, en kan kleine deeltjes afgeven. Onze plank is van massief metaal: glad, niet poreus en zonder coating.</p>"
          }
        },
        "q-2": {
          "type": "question",
          "settings": {
            "question": "Is een metalen snijplank veilig?",
            "answer": "<p>Ja. Er zit geen coating op die kan loslaten, en de plank neemt geen vocht of geuren op.</p>"
          }
        },
        "q-3": {
          "type": "question",
          "settings": {
            "question": "Wordt mijn mes er bot van?",
            "answer": "<p>Een harde plank maakt een snede sneller bot dan hout. Zet je messen regelmatig aan, dan blijven ze scherp.</p>"
          }
        },
        "q-4": {
          "type": "question",
          "settings": {
            "question": "Neemt de plank geuren of vlekken op?",
            "answer": "<p>Nee. Na vis, knoflook of rode biet spoel je hem af en is hij weer schoon.</p>"
          }
        },
        "q-5": {
          "type": "question",
          "settings": {
            "question": "Mag de plank in de vaatwasser?",
            "answer": "<p>[Vul in wat voor jouw plank geldt.] Met warm water en een beetje afwasmiddel ben je meestal sneller klaar.</p>"
          }
        },
        "q-6": {
          "type": "question",
          "settings": {
            "question": "Hoe lang gaat de plank mee?",
            "answer": "<p>Bij normaal gebruik jarenlang: er is geen coating die kan slijten.</p>"
          }
        },
        "q-7": {
          "type": "question",
          "settings": {
            "question": "Is de plank zwaar?",
            "answer": "<p>[Vul het gewicht per maat in.]</p>"
          }
        }
