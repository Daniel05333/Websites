{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    {%- assign vk_balance = gift_card.balance | money -%}
    {%- assign vk_initial = gift_card.initial_value | money -%}
    {%- assign vk_expires = gift_card.expires_on | date: '%d %B %Y' -%}
    <title>{{ 'gift_cards.issued.title' | t: value: vk_balance, shop: shop.name }}</title>
    {% render 'vk-fonts' %}
    {% render 'vk-color-schemes' %}
    {{ 'vk-base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <style>
      .vk-gc { min-height: 100svh; display: grid; place-items: center; padding: 2rem 1rem; background: radial-gradient(60% 60% at 50% 30%, rgba(215,38,30,.25), transparent 70%), #080808; }
      .vk-gc__card { width: min(100%, 520px); display: grid; gap: 1.5rem; justify-items: center; text-align: center; padding: 2.5rem 2rem; border-radius: 28px; background: rgba(247,245,242,.04); box-shadow: inset 0 0 0 1px rgba(247,245,242,.12); }
      .vk-gc__amount { font-family: var(--vk-font-display); font-size: clamp(3rem, 10vw, 5rem); font-weight: 500; letter-spacing: -0.05em; line-height: 1; }
      .vk-gc__code { font-family: var(--vk-font-mono); font-size: 1.25rem; letter-spacing: .18em; padding: .9rem 1.25rem; border-radius: 12px; box-shadow: inset 0 0 0 1px rgba(247,245,242,.24); }
      #vk-gc-qr { background: #fff; padding: 12px; border-radius: 12px; }
      @media print { .vk-gc__actions { display: none; } }
    </style>
  </head>
  <body class="color-scheme-1">
    <main class="vk-gc">
      <div class="vk-gc__card">
        {% render 'vk-logo', size: 'lg' %}
        <p class="vk-eyebrow">{{ 'gift_cards.issued.subtext' | t }}</p>
        <p class="vk-gc__amount">{{ gift_card.balance | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value %}<p class="vk-muted">{{ 'gift_cards.issued.initial_value' | t: value: vk_initial }}</p>{% endif -%}
        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="vk-badge vk-badge--outline">{{ 'gift_cards.issued.expired' | t }}</p>
        {%- elsif gift_card.expires_on -%}
          <p class="vk-small vk-muted">{{ 'gift_cards.issued.expires_on' | t: expires_on: vk_expires }}</p>
        {%- endif -%}
        <p class="vk-gc__code" id="vk-gc-code">{{ gift_card.code | format_code }}</p>
        <div id="vk-gc-qr" data-identifier="{{ gift_card.qr_identifier }}"></div>
        <div class="vk-gc__actions vk-btn-row">
          <a href="{{ shop.url }}" class="vk-btn vk-btn--primary"><span class="vk-btn__label">{{ 'gift_cards.issued.shop_link' | t }}</span></a>
          <button type="button" class="vk-btn vk-btn--secondary" onclick="navigator.clipboard && navigator.clipboard.writeText(document.getElementById('vk-gc-code').textContent.trim())"><span class="vk-btn__label">{{ 'gift_cards.issued.copy_code' | t }}</span></button>
          <button type="button" class="vk-btn vk-btn--ghost" onclick="window.print()"><span class="vk-btn__label">{{ 'gift_cards.issued.print' | t }}</span></button>
        </div>
        {%- if gift_card.pass_url %}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_cards.issued.add_to_apple_wallet' | t }}" loading="lazy"></a>{% endif -%}
      </div>
    </main>
    <script>
      window.addEventListener('load', function () { var el = document.getElementById('vk-gc-qr'); if (window.QRCode && el) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 }); });
    </script>
  </body>
</html>
