    "faq": {
      "type": "vk-faq",
      "settings": {
        "layout": "split",
        "index": "",
        "eyebrow": "Vragen",
        "heading": "Twijfel je <em>nog</em>?",
        "subheading": "De antwoorden op de vragen die we het vaakst krijgen.",
        "show_filter": false,
        "contact_title": "Staat je vraag er niet bij?",
