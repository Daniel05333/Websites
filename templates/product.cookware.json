    "solution": {
      "type": "vk-solution",
      "settings": {
        "index": "",
        "eyebrow": "Het Volkara-verschil",
        "heading": "Geen coating. Gewoon <em>titanium</em>.",
        "subheading": "Bij Volkara kook je direct op titanium. Er is niets opgespoten, dus er is niets dat kan afslijten. Elk detail is ontworpen voor hoe je thuis echt kookt.",
        "fallback": "vk-visual-pan.webp",
