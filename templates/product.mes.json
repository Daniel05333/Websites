      "blocks": {
        "q-1": {
          "type": "question",
          "settings": {
            "question": "Welk mes moet ik als eerste kopen?",
            "answer": "<p>Begin met een koksmes van ongeveer 20 cm: daarmee snijd je groente, vlees en kruiden. Een santoku is een goed alternatief als je liever een kortere, hogere kling hebt.</p>"
          }
        },
        "q-2": {
          "type": "question",
          "settings": {
            "question": "Mag het mes in de vaatwasser?",
            "answer": "<p>Liever niet. De hitte, het zout en het botsen tegen ander vaatwerk maken de snede sneller bot. Spoel het mes af met warm water en droog het direct.</p>"
          }
        },
        "q-3": {
          "type": "question",
          "settings": {
            "question": "Hoe houd ik het mes scherp?",
            "answer": "<p>Snijd op een houten of kunststof plank, zet het mes regelmatig aan en laat het slijpen als aanzetten niet meer helpt.</p>"
          }
        },
        "q-4": {
          "type": "question",
          "settings": {
            "question": "Is het een goed cadeau?",
            "answer": "<p>Ja. Een goed mes wordt elke dag gebruikt. En past het toch niet, dan kan het binnen 30 dagen retour.</p>"
          }
        },
        "q-5": {
          "type": "question",
          "settings": {
            "question": "Hoe zit het met verzenden en retourneren?",
            "answer": "<p>Verzenden is gratis. Je hebt 30 dagen om je bestelling terug te sturen; lees meer op de pagina <a href=\"/pages/verzenden-en-retourneren\">Verzenden en retourneren</a>.</p>"
          }
        }
