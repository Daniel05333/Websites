          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "question": "Hoe kan ik betalen?",
            "answer": "<p>Je ziet alle beschikbare betaalmethoden bij het afrekenen. De betaling loopt via een beveiligde checkout.</p>"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "question": "Hoe volg ik mijn bestelling?",
            "answer": "<p>Zodra je pakket onderweg is, krijg je een e-mail met een track-and-tracelink. Meer lees je op de pagina <a href=\"/pages/bestelling-volgen\">Bestelling volgen</a>.</p>"
          }
