    "faq": {
      "type": "vk-faq",
      "settings": {
        "layout": "split",
        "index": "04",
        "eyebrow": "Technical FAQ",
        "heading": "The science, <em>simply</em>.",
        "subheading": "For the cooks who want to know exactly what they're cooking on.",
        "show_filter": false,
        "contact_title": "Still curious?",
        "contact_text": "Talk to a person — we reply within one working day.",
        "contact_url": "/pages/contact",
