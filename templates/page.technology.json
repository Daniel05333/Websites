      "type": "vk-faq",
      "settings": {
        "layout": "split",
        "index": "04",
        "eyebrow": "Technische vragen",
        "heading": "De techniek, <em>simpel</em> uitgelegd.",
        "subheading": "Voor wie precies wil weten waarop hij kookt.",
