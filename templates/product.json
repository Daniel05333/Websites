    "problem": {
      "type": "vk-problem",
      "settings": {
        "index": "02",
        "eyebrow": "The problem",
        "heading": "Your pan is quietly <em>failing</em> you.",
        "subheading": "Why most pans don't last — and why this one does.",
        "transition_text": "There is a better way",
