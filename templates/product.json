      "blocks": {
        "card-1": {
          "type": "card",
          "settings": {
            "fallback": "none",
            "stat": "BUILT TO BE REPLACED",
            "stat_label": "the business model of a coated pan",
            "title": "Built to expire",
            "text": "<p>Coated pans are sold as consumables: the surface begins to degrade from the first hot sear. A few years later they're scraped, stained and back on your shopping list.</p>"
          }
        },
        "card-2": {
          "type": "card",
          "settings": {
            "fallback": "vk-visual-problem-coating.webp",
            "stat": "1 SCRATCH",
            "stat_label": "is all it takes to breach a coating",
            "title": "Coatings that flake",
            "text": "<p>One slip of a metal spatula and the damage is done. A scratched coating loses its release — and whatever flakes away has to go somewhere.</p>"
          }
        },
        "card-3": {
          "type": "card",
          "settings": {
            "fallback": "none",
            "stat": "HOT SPOTS",
            "stat_label": "the signature of a thin, single-layer base",
            "title": "Heat that lies",
            "text": "<p>Thin bases warp and build hot spots, so the centre scorches while the rim stays pale. You end up cooking around your pan instead of with it.</p>"
          }
        }
      },
      "block_order": [
        "card-1",
        "card-2",
        "card-3"
      ]
