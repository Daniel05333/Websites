          "type": "question",
          "settings": {
            "question": "How do I start a return or the home trial?",
            "answer": "<p>Contact us with your order number within 60 days of delivery. We'll send return instructions; once the piece is back with us, we refund the purchase price to your original payment method.</p>"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "question": "How do I withdraw from my purchase?",
            "answer": "<p>Use \"Withdraw from a contract\" in the footer, or tell us by email within 14 days of delivery. We'll confirm receipt straight away. Your statutory right of withdrawal applies alongside our 60-day home trial.</p>"
          }
        },
        "question-5": {
          "type": "question",
          "settings": {
            "question": "How do I make a warranty claim?",
            "answer": "<p>Send your order number and a photo of the issue. If it's covered, we'll repair or replace the piece.</p>"
          }
        },
        "question-6": {
          "type": "question",
          "settings": {
            "question": "Which countries do you ship to?",
            "answer": "<p>We ship to the countries shown at checkout. Shipping is free over €75 to every listed destination.</p>"
