          "settings": {
            "question": "Where is my order?",
            "answer": "<p>You'll receive a tracking link by email as soon as your order is dispatched. You can also see its status in your account. If it hasn't moved for three working days, contact us and we'll chase it.</p>"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "question": "Can I change or cancel my order?",
            "answer": "<p>If it hasn't been dispatched yet, yes — contact us as soon as possible with your order number. Once it's on its way, you can use the home trial or your right of withdrawal instead.</p>"
          }
        },
