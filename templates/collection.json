    "faq": {
      "type": "vk-faq",
      "settings": {
        "layout": "split",
        "index": "",
        "eyebrow": "Buying guide",
        "heading": "Before you <em>choose</em>.",
        "subheading": "Quick answers to the questions we hear most at this stage.",
