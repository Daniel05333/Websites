{{ 'vk-section-shop.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- assign s = section.settings -%}
{%- comment -%} Each row shows the product's metafield when it has one, otherwise the fixed text. Empty rows are skipped. {%- endcomment -%}
{%- capture vk_rows -%}
  {%- comment -%} 1. Rows read from the product description: the list under a heading such as "Specificaties", one "Label: waarde" per bullet. {%- endcomment -%}
  {%- if s.from_description and product != blank and s.desc_heading != blank -%}
    {%- assign vk_parts = product.description | split: s.desc_heading -%}
    {%- if vk_parts.size > 1 -%}
      {%- assign vk_list = vk_parts[1] | split: '</ul>' | first -%}
      {%- assign vk_items = vk_list | split: '</li>' -%}
      {%- for vk_item in vk_items -%}
        {%- assign vk_text = vk_item | strip_html | strip -%}
        {%- if vk_text contains ':' -%}
          {%- assign vk_label = vk_text | split: ':' | first | strip -%}
          {%- assign vk_value = vk_text | remove_first: vk_label | remove_first: ':' | strip -%}
          {%- if vk_label != blank and vk_value != blank -%}<div class="vk-specs__row"><dt>{{ vk_label }}</dt><dd>{{ vk_value }}</dd></div>{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}
  {%- comment -%} 2. Extra rows from blocks (metafield or fixed text). {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign vk_val = ''
      if b.metafield != blank and product != blank
        assign vk_keys = b.metafield | strip | split: '.'
        if vk_keys.size == 2
          assign vk_ns = vk_keys[0]
          assign vk_key = vk_keys[1]
          assign vk_mf = product.metafields[vk_ns][vk_key]
          if vk_mf != blank
            assign vk_val = vk_mf.value | default: vk_mf
          endif
        endif
      endif
      if vk_val == blank
        assign vk_val = b.value
      endif
    -%}
    {%- if vk_val != blank and b.label != blank -%}
      <div class="vk-specs__row" {{ block.shopify_attributes }}><dt>{{ b.label }}</dt><dd>{{ vk_val }}</dd></div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if vk_rows != blank or request.design_mode -%}
<section id="vk-{{ section.id }}" class="vk-section vk-specs color-{{ s.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="vk-container">
    <div class="vk-specs__panel" data-reveal>
      <div>
        {%- if s.eyebrow != blank -%}<p class="vk-eyebrow"><span class="vk-eyebrow__line" aria-hidden="true"></span>{{ s.eyebrow }}</p>{%- endif -%}
        <h2 class="vk-specs__title">{{ s.heading }}</h2>
        <dl class="vk-specs__list">{{ vk_rows }}</dl>
        {%- if vk_rows == blank -%}<p class="vk-muted">Nog geen specificaties: zet een lijst onder het kopje "Specificaties" in de productbeschrijving, of voeg rijen toe. Deze melding zien bezoekers niet.</p>{%- endif -%}
      </div>
      {%- liquid
        assign vk_img = s.image
        if vk_img == blank and s.use_product_image
          assign vk_img = product.featured_image
        endif
      -%}
      {%- if vk_img != blank -%}
        <div class="vk-specs__media" aria-hidden="true">{%- render 'vk-image', image: vk_img, sizes: '(min-width: 750px) 320px, 200px', alt: '' -%}</div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Specifications",
  "tag": "div",
  "class": "vk-spec-table-section",
  "settings": [
    { "type": "paragraph", "content": "Rows come from the product description (the list under the heading below, one 'Label: value' per bullet) and from the rows you add here. A row shows the product's metafield when it has one, otherwise its fixed text. Empty rows are hidden." },
    { "type": "checkbox", "id": "from_description", "label": "Read specs from the product description", "default": true },
    { "type": "text", "id": "desc_heading", "label": "Heading in the description", "default": "Specificaties" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specificaties" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "checkbox", "id": "use_product_image", "label": "Use the product photo when no image is set", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "limit": 14,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Lemmetlengte" },
        { "type": "text", "id": "metafield", "label": "Product metafield", "info": "namespace.key, e.g. custom.lemmetlengte. Leave empty to always use the text below." },
        { "type": "text", "id": "value", "label": "Text", "info": "Used when the product has no value in the metafield." }
      ]
    }
  ],
  "presets": [{ "name": "Specifications" }]
}
{% endschema %}
