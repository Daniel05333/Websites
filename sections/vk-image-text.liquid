{{ 'vk-section-proof.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- assign s = section.settings -%}
<section id="vk-{{ section.id }}" class="vk-section vk-imgtext vk-imgtext--{{ s.image_position }} color-{{ s.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="vk-container vk-imgtext__grid">
    <div class="vk-imgtext__media vk-ratio-{{ s.ratio }}" data-reveal="mask">
      <div class="vk-imgtext__media-inner" data-parallax="0.08">
        {%- render 'vk-image', image: s.image, sizes: '(min-width: 990px) 50vw, 100vw', fallback: s.fallback, fallback_width: 1024, fallback_height: 1024, placeholder: s.placeholder, alt: s.image_alt -%}
      </div>
    </div>
    <div class="vk-imgtext__copy">
      {%- render 'vk-heading', index: s.index, eyebrow: s.eyebrow, heading: s.heading -%}
      {%- if s.text != blank %}<div class="vk-rte vk-imgtext__text" data-reveal>{{ s.text }}</div>{% endif -%}
      {%- if section.blocks.size > 0 -%}
        <dl class="vk-imgtext__stats" data-reveal-stagger>
          {%- for block in section.blocks -%}
            <div data-reveal {{ block.shopify_attributes }}><dt>{{ block.settings.label }}</dt><dd>{{ block.settings.value }}</dd></div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
      {%- if s.button_label != blank %}<div data-reveal>{% render 'vk-button', label: s.button_label, url: s.button_url, style: 'secondary', icon: 'arrow-right' %}</div>{% endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "div",
  "class": "vk-imgtext-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback", "label": "Bundled visual", "default": "vk-visual-forge.webp", "options": [
      { "value": "vk-visual-forge.webp", "label": "Forge & sparks" }, { "value": "vk-visual-chef.webp", "label": "Chef flambé" }, { "value": "vk-visual-sear.webp", "label": "Steak sear" }, { "value": "vk-visual-macro.webp", "label": "LavaCell™ macro" }, { "value": "vk-visual-pan.webp", "label": "Forge Pan" }
    ] },
    { "type": "select", "id": "placeholder", "label": "Placeholder art", "default": "chef", "options": [{ "value": "chef", "label": "Flame" }, { "value": "macro", "label": "Texture" }, { "value": "product", "label": "Pan" }] },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] },
    { "type": "select", "id": "ratio", "label": "Image ratio", "default": "portrait", "options": [{ "value": "portrait", "label": "Portrait" }, { "value": "square", "label": "Square" }, { "value": "landscape", "label": "Landscape" }] },
    { "type": "text", "id": "index", "label": "Chapter number" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Craft & engineering" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Hammered by hand. <em>Measured</em> by machine." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat", "limit": 4, "settings": [
      { "type": "text", "id": "value", "label": "Value", "default": "5-PLY" },
      { "type": "text", "id": "label", "label": "Label", "default": "forged construction" }
    ] }
  ],
  "presets": [{ "name": "VOLKARA · Image with text" }]
}
{% endschema %}
