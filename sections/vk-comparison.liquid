{{ 'vk-section-proof.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign vk_has_c2 = false
  if s.competitor_2 != blank
    assign vk_has_c2 = true
  endif
-%}
<section id="vk-{{ section.id }}" class="vk-section vk-compare color-{{ s.color_scheme }}" data-section-id="{{ section.id }}"{% if section.settings.stack_effect %} data-stack{% endif %}>
  {%- if section.settings.show_contours -%}<vk-contours aria-hidden="true"></vk-contours>{%- endif -%}
  <div class="vk-container">
    {%- render 'vk-heading', index: s.index, eyebrow: s.eyebrow, heading: s.heading, subheading: s.subheading, align: 'center' -%}
    <vk-compare class="vk-compare__wrap{% if vk_has_c2 %} has-c2{% endif %}" data-show="1" data-reveal>
      {%- if vk_has_c2 -%}
        <div class="vk-compare__switch vk-hide-desktop" role="group" aria-label="{{ 'sections.comparison.compare_with' | t }}">
          <span class="vk-mono vk-subtle">{{ 'sections.comparison.compare_with' | t }}</span>
          <button type="button" class="vk-chip is-active" aria-pressed="true" data-compare-show="1">{{ s.competitor_1 }}</button>
          <button type="button" class="vk-chip" aria-pressed="false" data-compare-show="2">{{ s.competitor_2 }}</button>
        </div>
      {%- endif -%}
      <table class="vk-compare__table">
        <caption class="vk-visually-hidden">{{ s.eyebrow }}</caption>
        <thead>
          <tr>
            <td class="vk-compare__corner"></td>
            <th scope="col" class="vk-compare__head vk-compare__head--ours">{% render 'vk-logo', size: 'sm' %}</th>
            <th scope="col" class="vk-compare__head vk-compare__c1">{{ s.competitor_1 }}</th>
            {%- if vk_has_c2 %}<th scope="col" class="vk-compare__head vk-compare__c2">{{ s.competitor_2 }}</th>{% endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- if b.group != blank -%}
              <tr class="vk-compare__group"><th scope="rowgroup" colspan="{% if vk_has_c2 %}4{% else %}3{% endif %}" class="vk-mono">{{ b.group }}</th></tr>
            {%- endif -%}
            <tr class="vk-compare__row" style="--vk-i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
              <th scope="row" class="vk-compare__feature">{{ b.feature }}</th>
              <td class="vk-compare__cell vk-compare__cell--ours"><span class="vk-compare__status vk-compare__status--yes">{% render 'vk-compare-icon', status: 'yes' %}</span><span>{{ b.ours }}</span></td>
              <td class="vk-compare__cell vk-compare__c1"><span class="vk-compare__status vk-compare__status--{{ b.c1_status }}">{% render 'vk-compare-icon', status: b.c1_status %}</span><span>{{ b.c1_text }}</span></td>
              {%- if vk_has_c2 -%}
                <td class="vk-compare__cell vk-compare__c2"><span class="vk-compare__status vk-compare__status--{{ b.c2_status }}">{% render 'vk-compare-icon', status: b.c2_status %}</span><span>{{ b.c2_text }}</span></td>
              {%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
      {%- if s.footnote != blank or s.button_label != blank -%}
        <div class="vk-compare__foot">
          {%- if s.footnote != blank -%}<p class="vk-compare__promise">{% render 'vk-icon', name: 'shield', size: 18 %}<span>{{ s.footnote }}</span></p>{%- endif -%}
          {%- if s.button_label != blank -%}{%- render 'vk-button', label: s.button_label, url: s.button_url, icon: 'arrow-right', size: 'sm' -%}{%- endif -%}
        </div>
      {%- endif -%}
    </vk-compare>
  </div>
</section>
<script src="{{ 'vk-proof.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Comparison",
  "tag": "div",
  "class": "vk-compare-section",
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Chapter number",
      "default": "07"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "De vergelijking"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Niet elke pan is <em>hetzelfde</em>."
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "Zo verhoudt VolcanicCore™ zich tot de pannen die in veel keukens al staan."
    },
    {
      "type": "text",
      "id": "competitor_1",
      "label": "Competitor 1",
      "default": "Antiaanbaklaag"
    },
    {
      "type": "text",
      "id": "competitor_2",
      "label": "Competitor 2",
      "info": "Leave empty for a two-column comparison.",
      "default": "Gietijzer"
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Vergeleken met gangbare aluminium pannen met een PTFE-antiaanbaklaag en traditioneel, onbehandeld gietijzer. Afzonderlijke producten kunnen verschillen."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Kies je pan"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "stack_effect",
      "label": "Stack effect",
      "info": "Desktop: the section pins and the next one slides over it.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_contours",
      "label": "Animated contour lines",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "limit": 14,
      "settings": [
        {
          "type": "text",
          "id": "group",
          "label": "Group heading (optional)",
          "info": "Starts a new group above this row."
        },
        {
          "type": "text",
          "id": "feature",
          "label": "Feature",
          "default": "Aanbraden"
        },
        {
          "type": "text",
          "id": "ours",
          "label": "VOLKARA",
          "default": "Mooie, gelijkmatige korst"
        },
        {
          "type": "select",
          "id": "c1_status",
          "label": "Competitor 1 status",
          "default": "no",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "partial",
              "label": "Partial"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        {
          "type": "text",
          "id": "c1_text",
          "label": "Competitor 1 text",
          "default": "Coating verdraagt geen hoge hitte"
        },
        {
          "type": "select",
          "id": "c2_status",
          "label": "Competitor 2 status",
          "default": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "partial",
              "label": "Partial"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        {
          "type": "text",
          "id": "c2_text",
          "label": "Competitor 2 text",
          "default": "Goede korst"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VOLKARA · Comparison",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "group": "Prestaties"
          }
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
