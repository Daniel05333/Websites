{{ 'vk-section-shop.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign vk_heading = s.heading
  if vk_heading == blank
    assign vk_heading = collection.title
  endif
  assign vk_text = s.text
  if vk_text == blank and s.show_description
    assign vk_text = collection.description | strip_html | truncate: 200
  endif
  assign vk_img = s.image | default: collection.image
  # A countdown only shows with a real end date the merchant sets (EU rules on honest urgency).
  assign vk_end = s.ends_at | strip
  assign vk_end_ts = 0
  if vk_end != blank
    assign vk_end_ts = vk_end | date: '%s' | plus: 0
  endif
  assign vk_now = 'now' | date: '%s' | plus: 0
  assign vk_show_clock = false
  if vk_end_ts > vk_now
    assign vk_show_clock = true
  endif
-%}
<section id="vk-{{ section.id }}" class="vk-section vk-sale-hero color-{{ s.color_scheme }}" data-section-id="{{ section.id }}">
  {%- if s.video != blank -%}
    <div class="vk-sale-hero__media vk-sale-hero__media--video" aria-hidden="true">{{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1920x' }}</div>
  {%- elsif s.video_url != blank -%}
    <div class="vk-sale-hero__media vk-sale-hero__media--video" aria-hidden="true"><video src="{{ s.video_url }}" autoplay muted loop playsinline preload="metadata"{% if vk_img != blank %} poster="{{ vk_img | image_url: width: 1920 }}"{% endif %}></video></div>
  {%- elsif vk_img != blank -%}
    <div class="vk-sale-hero__media" aria-hidden="true">{%- render 'vk-image', image: vk_img, sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: '' -%}</div>
  {%- endif -%}
  <div class="vk-sale-hero__shade" aria-hidden="true"></div>
  {%- if s.show_embers %}<vk-embers count="28"></vk-embers>{% endif -%}
  <div class="vk-container">
    <div class="vk-sale-hero__grid">
      <div class="vk-sale-hero__copy">
        {%- if s.rating_text != blank -%}<p class="vk-sale-hero__rating" data-reveal="fade"><span class="vk-sale-hero__stars" aria-hidden="true">★★★★★</span><span>{{ s.rating_text }}</span></p>{%- endif -%}
        {%- if s.eyebrow != blank -%}<p class="vk-eyebrow" data-reveal="fade"><span class="vk-eyebrow__line" aria-hidden="true"></span>{{ s.eyebrow }}</p>{%- endif -%}
        <h1 class="vk-sale-hero__title" data-split>{{ vk_heading }}</h1>
        {%- if vk_text != blank -%}<p class="vk-sale-hero__text" data-reveal>{{ vk_text }}</p>{%- endif -%}
      </div>
      {%- if vk_show_clock -%}
        <vk-sale-clock class="vk-sale-clock" data-end="{{ vk_end_ts }}" data-dhm="{{ 'general.countdown.days' | t }}|{{ 'general.countdown.hours' | t }}|{{ 'general.countdown.minutes' | t }}" data-hms="{{ 'general.countdown.hours' | t }}|{{ 'general.countdown.minutes' | t }}|{{ 'general.countdown.seconds' | t }}" data-reveal>
          <p class="vk-sale-clock__label">{{ s.clock_label }}</p>
          <div class="vk-sale-clock__digits" aria-hidden="true">
            <span class="vk-sale-clock__unit"><span class="vk-sale-clock__num" data-d>00</span><span class="vk-sale-clock__sub">{{ 'general.countdown.days' | t }}</span></span>
            <span class="vk-sale-clock__sep">:</span>
            <span class="vk-sale-clock__unit"><span class="vk-sale-clock__num" data-h>00</span><span class="vk-sale-clock__sub">{{ 'general.countdown.hours' | t }}</span></span>
            <span class="vk-sale-clock__sep">:</span>
            <span class="vk-sale-clock__unit"><span class="vk-sale-clock__num" data-m>00</span><span class="vk-sale-clock__sub">{{ 'general.countdown.minutes' | t }}</span></span>
          </div>
          <p class="vk-visually-hidden">{{ s.clock_label }} {{ vk_end_ts | date: '%d-%m-%Y %H:%M' }}</p>
          {%- if s.clock_note != blank -%}<p class="vk-sale-clock__note">{{ s.clock_note }}</p>{%- endif -%}
        </vk-sale-clock>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="vk-sale-usps" role="list" style="--n: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          <li class="vk-sale-usp" {{ block.shopify_attributes }}>
            {%- render 'vk-icon', name: block.settings.icon, size: 20 -%}
            <span><span class="vk-sale-usp__title">{{ block.settings.title }}</span>{%- if block.settings.text != blank -%}<span class="vk-sale-usp__text">{{ block.settings.text }}</span>{%- endif -%}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- if vk_show_clock -%}
<script>
  if (!customElements.get('vk-sale-clock')) customElements.define('vk-sale-clock', class extends HTMLElement {
    connectedCallback() {
      const end = Number(this.dataset.end) * 1000, pad = (n) => String(n).padStart(2, '0');
      const d = this.querySelector('[data-d]'), h = this.querySelector('[data-h]'), m = this.querySelector('[data-m]');
      const tick = () => {
        const left = end - Date.now();
        if (left <= 0) { this.hidden = true; clearInterval(this.timer); return; }
        // More than a day left: days : hours : minutes. Last day: hours : minutes : seconds.
        const lastDay = left < 864e5;
        if (lastDay !== this.lastDay) { this.lastDay = lastDay; this.labels.forEach((el, i) => { el.textContent = (lastDay ? this.dataset.hms : this.dataset.dhm).split('|')[i]; }); }
        const parts = lastDay ? [Math.floor(left / 36e5), Math.floor(left / 6e4) % 60, Math.floor(left / 1e3) % 60] : [Math.floor(left / 864e5), Math.floor(left / 36e5) % 24, Math.floor(left / 6e4) % 60];
        d.textContent = pad(parts[0]); h.textContent = pad(parts[1]); m.textContent = pad(parts[2]);
      };
      this.labels = [...this.querySelectorAll('.vk-sale-clock__sub')];
      tick(); this.timer = setInterval(tick, 1000);
    }
    disconnectedCallback() { clearInterval(this.timer); }
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Sale hero",
  "tag": "div",
  "class": "vk-sale-hero-section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "rating_text",
      "label": "Rating line above the heading",
      "info": "Five stars plus your text, e.g. Beoordeeld met <b>Uitstekend</b> | 1.200+ klanten. Only use numbers you can show."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Op = op"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Empty uses the collection title.",
      "default": "Restock <em>sale</em>"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "We hebben te veel voorraad en maken ruimte. Op is op."
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Use collection description when text is empty",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Empty uses the collection image."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Upload a short, silent loop (mp4). Plays muted behind the text; the image is used until it loads."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Background video URL",
      "info": "Alternative to the upload: a direct .mp4 link."
    },
    {
      "type": "checkbox",
      "id": "show_embers",
      "label": "Embers",
      "default": true
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "paragraph",
      "content": "Only shown with a real end date and hidden once it has passed. Use the actual end of your sale: a countdown that restarts is misleading and not allowed in the EU."
    },
    {
      "type": "text",
      "id": "ends_at",
      "label": "Sale ends at",
      "info": "Format: 2026-11-30 23:59 (store time zone). Leave empty to hide the countdown."
    },
    {
      "type": "text",
      "id": "clock_label",
      "label": "Countdown label",
      "default": "Actie eindigt over"
    },
    {
      "type": "text",
      "id": "clock_note",
      "label": "Note under the countdown",
      "default": "Daarna gelden weer de normale prijzen."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "leaf",
          "options": [
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "warranty",
              "label": "Warranty"
            },
            {
              "value": "flame",
              "label": "Flame"
            },
            {
              "value": "fire-ring",
              "label": "Cooktop"
            },
            {
              "value": "induction",
              "label": "Induction"
            },
            {
              "value": "hexagon",
              "label": "Hexagon"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "return",
              "label": "Return"
            },
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "knife",
              "label": "Knife"
            },
            {
              "value": "check-circle",
              "label": "Check"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% PFAS-vrij"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Geen PFAS of PTFE"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sale hero",
      "blocks": [
        {
          "type": "usp"
        },
        {
          "type": "usp"
        },
        {
          "type": "usp"
        }
      ]
    }
  ]
}
{% endschema %}
