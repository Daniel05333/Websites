{{ 'vk-section-gift.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign vk_checks = s.checks | newline_to_br | split: '<br />'
  # On a product page the product title is the h1, so the hero steps down to h2.
  assign vk_tag = 'h1'
  if template.name == 'product'
    assign vk_tag = 'h2'
  endif
  assign vk_url = s.button_url | default: '#'
  if s.button_to_buy and template.name == 'product'
    assign vk_url = '#buy'
  endif
-%}
<section id="vk-{{ section.id }}" class="vk-section vk-gift-hero color-{{ s.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="vk-gift-hero__grid">
    <div class="vk-gift-hero__copy">
      {%- if s.rating_text != blank -%}
        <p class="vk-gift-hero__rating" data-reveal="fade">
          <span class="vk-gift-hero__stars" aria-hidden="true">{%- for i in (1..5) -%}{% render 'vk-icon', name: 'star', size: 15 %}{%- endfor -%}</span>
          {{ s.rating_text }}
        </p>
      {%- endif -%}
      <{{ vk_tag }} class="vk-gift-hero__title" data-split>{{ s.heading }}</{{ vk_tag }}>
      {%- if s.text != blank -%}<p class="vk-gift-hero__text" data-reveal>{{ s.text }}</p>{%- endif -%}
      <div class="vk-gift-hero__cta" data-reveal data-reveal-delay="150">
        {%- if s.button_label != blank -%}<a class="vk-gift-btn" href="{{ vk_url }}">{{ s.button_label }}{% render 'vk-icon', name: 'arrow-right', size: 16 %}</a>{%- endif -%}
        {%- if s.checks != blank -%}
          <ul class="vk-gift-checks" role="list">
            {%- for c in vk_checks -%}{%- assign c = c | strip -%}{%- if c != blank -%}<li>{% render 'vk-icon', name: 'check-circle', size: 15 %}{{ c }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
    <div class="vk-gift-hero__media">
      {%- render 'vk-image', image: s.image, sizes: '(min-width: 900px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', fallback: s.fallback, fallback_width: 1920, fallback_height: 1080, placeholder: 'lifestyle', alt: s.image_alt -%}
      {%- if s.badge != blank -%}<span class="vk-gift-hero__badge" aria-hidden="true">{{ s.badge }}</span>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift hero",
  "tag": "div",
  "class": "vk-gift-hero-section",
  "settings": [
    { "type": "text", "id": "rating_text", "label": "Rating line", "info": "Shown with five stars. Only use a score you can prove (e.g. from your reviews app). Leave empty to hide." },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Geef iets dat <em>blijft</em>" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Bloemen zijn na een week weg. Een Volkara-pan staat over jaren nog op het fornuis, en elke keer dat ze koken, denken ze even aan jou." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Bekijk de cadeaus" },
    { "type": "url", "id": "button_url", "label": "Button link" },
    { "type": "checkbox", "id": "button_to_buy", "label": "Button scrolls to the buy box", "info": "On a product page: jumps to the product's add-to-cart.", "default": false },
    { "type": "textarea", "id": "checks", "label": "Check marks", "info": "One per line.", "default": "Gratis verzending\n30 dagen retour\n25 jaar garantie" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "fallback", "label": "Bundled visual (when no image is set)", "default": "vk-visual-hero.webp", "options": [
      { "value": "vk-visual-hero.webp", "label": "Pan, hero" }, { "value": "vk-visual-pan-angle.webp", "label": "Pan, top view" },
      { "value": "vk-visual-pan.webp", "label": "Pan, product" }, { "value": "vk-visual-macro.webp", "label": "Hammered surface" }, { "value": "vk-visual-handle.webp", "label": "Handle" }
    ] },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Een Volkara-pan als cadeau" },
    { "type": "text", "id": "badge", "label": "Round badge", "default": "PFAS-vrij" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Gift hero" }]
}
{% endschema %}
