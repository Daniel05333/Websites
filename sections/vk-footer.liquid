{{ 'vk-section-footer.css' | asset_url | stylesheet_tag }}
<footer id="vk-{{ section.id }}" class="vk-footer color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="vk-container">
    {%- if section.settings.show_newsletter -%}
      <div class="vk-footer__top" data-reveal>
        <div class="vk-footer__statement">
          <p class="vk-eyebrow">{{ section.settings.newsletter_eyebrow }}</p>
          <p class="vk-footer__statement-text vk-h3">{{ section.settings.newsletter_text }}</p>
        </div>
        {%- assign vk_form_id = 'vk-footer-newsletter-' | append: section.id -%}
        {%- form 'customer', id: vk_form_id, class: 'vk-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="vk-form-message vk-form-message--success" role="status">{% render 'vk-icon', name: 'check-circle', size: 18 %}{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            <div class="vk-inline-form">
              <label for="{{ vk_form_id }}-email" class="vk-visually-hidden">{{ 'newsletter.label' | t }}</label>
              <input id="{{ vk_form_id }}-email" type="email" name="contact[email]" class="vk-input" required autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}">
              <button type="submit" class="vk-btn vk-btn--primary"><span class="vk-btn__label">{{ 'newsletter.button' | t }}{% render 'vk-icon', name: 'arrow-right', size: 18 %}</span></button>
            </div>
            {%- if form.errors %}<p class="vk-form-message vk-form-message--error" role="alert">{{ 'newsletter.error' | t }}</p>{% endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="vk-footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="vk-footer__brand" {{ block.shopify_attributes }}>
              {% render 'vk-logo' %}
              {%- if block.settings.text != blank %}<div class="vk-footer__blurb">{{ block.settings.text }}</div>{% endif -%}
              <ul class="vk-footer__contact" role="list">
                {%- if block.settings.email != blank -%}
                  <li><span class="vk-footer__contact-icon">{% render 'vk-icon', name: 'mail', size: 16 %}</span><span><span class="vk-footer__contact-label">{{ 'footer.email' | t }}</span><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></span></li>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <li><span class="vk-footer__contact-icon">{% render 'vk-icon', name: 'clock', size: 16 %}</span><span><span class="vk-footer__contact-label">{{ 'footer.hours' | t }}</span>{{ block.settings.hours }}</span></li>
                {%- endif -%}
                {%- if block.settings.address != blank -%}
                  <li><span class="vk-footer__contact-icon">{% render 'vk-icon', name: 'map-pin', size: 16 %}</span><span><span class="vk-footer__contact-label">{{ 'footer.address' | t }}</span>{{ block.settings.address | newline_to_br }}</span></li>
                {%- endif -%}
              </ul>
              {% render 'vk-social-icons' %}
            </div>
          {%- when 'menu' -%}
            <vk-accordion class="vk-footer__menu" {{ block.shopify_attributes }}>
              <details class="vk-footer__details" open>
                <summary class="vk-footer__menu-title">{{ block.settings.heading | default: block.settings.menu.title }}<span class="vk-accordion__icon vk-hide-desktop" aria-hidden="true"></span></summary>
                <ul class="vk-footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="vk-footer__link">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            </vk-accordion>
          {%- when 'text' -%}
            <div class="vk-footer__text" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank %}<p class="vk-footer__menu-title">{{ block.settings.heading }}</p>{% endif -%}
              <div class="vk-rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_promises -%}
      <ul class="vk-footer__promises" role="list">
        {%- if settings.promise_warranty != blank %}<li>{% render 'vk-icon', name: 'shield', size: 18 %}{{ settings.promise_warranty }}</li>{% endif -%}
        {%- if settings.promise_trial != blank %}<li>{% render 'vk-icon', name: 'return', size: 18 %}{{ settings.promise_trial }}</li>{% endif -%}
        {%- if settings.promise_shipping != blank %}<li>{% render 'vk-icon', name: 'truck', size: 18 %}{{ settings.promise_shipping }}</li>{% endif -%}
        {%- if settings.promise_secure != blank %}<li>{% render 'vk-icon', name: 'lock', size: 18 %}{{ settings.promise_secure }}</li>{% endif -%}
      </ul>
    {%- endif -%}

    <div class="vk-footer__bottom">
      <p class="vk-footer__legal">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.legal_text }}</p>
      {% render 'vk-localization', id: 'footer' %}
      {%- if section.settings.show_payment_icons %}{% render 'vk-payment-icons' %}{% endif -%}
    </div>
  </div>
  {%- if section.settings.show_wordmark -%}
    <div class="vk-footer__wordmark" data-scrub aria-hidden="true"><span>VOLKARA</span></div>
  {%- endif -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "vk-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter band", "default": true },
    { "type": "text", "id": "newsletter_eyebrow", "label": "Newsletter eyebrow", "default": "The inner circle" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "New pieces, recipes and nothing you'll want to unsubscribe from." },
    { "type": "checkbox", "id": "show_promises", "label": "Show brand promises", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show giant wordmark", "default": true },
    { "type": "text", "id": "legal_text", "label": "Legal line", "default": "All rights reserved. All prices include VAT." }
  ],
  "blocks": [
    {
      "type": "brand", "name": "Brand & contact", "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Forged titanium cookware, engineered around VolcanicCore™. Built for the heat of serious home kitchens — and for the decades after.</p>" },
        { "type": "text", "id": "email", "label": "Email", "default": "support@volkara.com" },
        { "type": "text", "id": "hours", "label": "Opening hours", "default": "Mon–Fri, 09:00–17:00 CET" },
        { "type": "textarea", "id": "address", "label": "Address", "info": "Your registered business address (legally required imprint in the EU)." }
      ]
    },
    {
      "type": "menu", "name": "Menu", "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text", "name": "Text", "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share a few words about your shop.</p>" }
      ]
    }
  ]
}
{% endschema %}
