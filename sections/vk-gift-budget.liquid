{{ 'vk-section-gift.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign vk_foot_checks = s.foot_checks | newline_to_br | split: '<br />'
-%}
<section id="vk-{{ section.id }}" class="vk-section vk-gift-budget color-{{ s.color_scheme }}" data-section-id="{{ section.id }}">
  {%- if s.anchor != blank -%}<span id="{{ s.anchor | handleize }}" class="vk-gift-anchor" aria-hidden="true"></span>{%- endif -%}
  <div class="vk-container">
    {%- render 'vk-heading', eyebrow: s.eyebrow, heading: s.heading, subheading: s.subheading, align: 'center' -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="vk-gift-budget__grid" role="list" style="--n: {{ section.blocks.size | at_most: 4 }};" data-reveal-stagger>
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign p = b.product
            assign vk_url = b.link | default: p.url | default: '#'
            assign vk_img = b.image | default: p.featured_image
            assign vk_checks = b.checks | newline_to_br | split: '<br />'
          -%}
          <li class="vk-gift-tier" data-reveal {{ block.shopify_attributes }}>
            {%- if b.badge != blank -%}<span class="vk-gift-tier__badge">{{ b.badge }}</span>{%- endif -%}
            <a class="vk-gift-tier__media" href="{{ vk_url }}" tabindex="-1" aria-hidden="true">
              {%- render 'vk-image', image: vk_img, sizes: '(min-width: 1100px) 22vw, (min-width: 600px) 45vw, 80vw', placeholder: 'product', alt: '' -%}
            </a>
            <div class="vk-gift-tier__body">
              {%- if b.title != blank -%}<h3 class="vk-gift-tier__title">{{ b.title }}</h3>{%- endif -%}
              {%- if b.text != blank -%}<p class="vk-gift-tier__text">{{ b.text }}</p>{%- endif -%}
              {%- if p != blank -%}
                <p class="vk-gift-tier__product">{{ p.title }}</p>
                <p class="vk-gift-tier__price">
                  <span>{% if p.price_varies %}{{ 'products.product.price.from' | t }} {% endif %}{{ p.price_min | money }}</span>
                  {%- if p.compare_at_price_max > p.price_max -%}<s>{{ p.compare_at_price_max | money }}</s>{%- endif -%}
                </p>
              {%- endif -%}
              {%- if b.checks != blank -%}
                <ul class="vk-gift-tier__checks" role="list">
                  {%- for c in vk_checks -%}{%- assign c = c | strip -%}{%- if c != blank -%}<li>{% render 'vk-icon', name: 'check', size: 14 %}{{ c }}</li>{%- endif -%}{%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if b.button_label != blank -%}<a class="vk-gift-btn vk-gift-btn--sm" href="{{ vk_url }}">{{ b.button_label }}</a>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.foot_text != blank or s.foot_button_label != blank or s.foot_checks != blank -%}
      <div class="vk-gift-foot" data-reveal>
        {%- if s.foot_text != blank -%}<p class="vk-gift-foot__text">{{ s.foot_text }}</p>{%- endif -%}
        {%- if s.foot_button_label != blank -%}<a class="vk-gift-btn" href="{{ s.foot_button_url | default: '/collections/all' }}">{{ s.foot_button_label }}</a>{%- endif -%}
        {%- if s.foot_checks != blank -%}
          <ul class="vk-gift-checks" role="list">
            {%- for c in vk_foot_checks -%}{%- assign c = c | strip -%}{%- if c != blank -%}<li>{% render 'vk-icon', name: 'check', size: 14 %}{{ c }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gift budget cards",
  "tag": "div",
  "class": "vk-gift-budget-section",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "budget", "info": "Links can jump here with #budget at the end of the page URL." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Begin bij je budget" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Wat wil je <em>uitgeven</em>?" },
    { "type": "inline_richtext", "id": "subheading", "label": "Subheading", "default": "Kies een bedrag, wij laten zien wat het beste cadeau is." },
    { "type": "text", "id": "foot_text", "label": "Text under the cards", "default": "Alles wat je hier ziet, vind je ook los in de collectie." },
    { "type": "text", "id": "foot_button_label", "label": "Button under the cards", "default": "Bekijk alle pannensets" },
    { "type": "url", "id": "foot_button_url", "label": "Button link" },
    { "type": "textarea", "id": "foot_checks", "label": "Check marks under the button", "info": "One per line.", "default": "Gratis verzending\n30 dagen retour\n25 jaar garantie" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Budget card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "badge", "label": "Price badge", "default": "Tot €100" },
        { "type": "product", "id": "product", "label": "Product", "info": "Name, photo and price come from the product, so they are always current." },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title", "default": "Een attentie" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Klein cadeau, dagelijks gebruik." },
        { "type": "textarea", "id": "checks", "label": "Check marks", "info": "One per line.", "default": "Gratis verzending\n30 dagen retour" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Bekijk" },
        { "type": "url", "id": "link", "label": "Link override", "info": "Defaults to the product." }
      ]
    }
  ],
  "presets": [{ "name": "Gift budget cards", "blocks": [{ "type": "tier" }, { "type": "tier" }, { "type": "tier" }, { "type": "tier" }] }]
}
{% endschema %}
