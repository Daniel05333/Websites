{%- comment -%}
  Ad landing: the problem. The "rules" you live by with a non-stick pan, straight from the ad copy.
{%- endcomment -%}
{{ 'vk-lp.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- assign s = section.settings -%}
<section id="vk-{{ section.id }}" class="vk-section vk-lp vk-lp-pain color-{{ s.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="vk-container">
    <div class="vk-lp-head" data-reveal>
      {%- if s.eyebrow != blank %}<p class="vk-lp-eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
      {%- if s.heading != blank %}<h2 class="vk-lp-display vk-lp-h2">{{ s.heading }}</h2>{% endif -%}
      {%- if s.text != blank %}<p class="vk-lp-lead">{{ s.text | escape }}</p>{% endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="vk-lp-rules" role="list" data-reveal-stagger>
        {%- for block in section.blocks -%}
          <li class="vk-lp-rule" data-reveal {{ block.shopify_attributes }}>
            <span class="vk-lp-rule__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="vk-lp-rule__icon" aria-hidden="true">{% render 'vk-icon', name: block.settings.icon, size: 22 %}</span>
            <span class="vk-lp-rule__title">{{ block.settings.title | escape }}</span>
            {%- if block.settings.text != blank %}<span class="vk-lp-rule__text">{{ block.settings.text | escape }}</span>{% endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if s.closing != blank -%}
      <p class="vk-lp-pain__closing" data-reveal>{{ s.closing }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ad landing: problem",
  "tag": "div",
  "class": "vk-lp-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Herkenbaar?" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Met een antiaanbakpan sta je altijd op je <em>hoede</em>." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Je houdt je aan de regels, want de coating is kwetsbaar." },
    { "type": "inline_richtext", "id": "closing", "label": "Closing line", "default": "Eén verkeerde beweging en er zit een kras in. <strong>En is de coating eenmaal beschadigd, dan is de pan aan vervanging toe.</strong>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 112 }
  ],
  "blocks": [
    {
      "type": "rule",
      "name": "Rule",
      "limit": 6,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "spoon", "options": [
          { "value": "spoon", "label": "Spoon" }, { "value": "utensils", "label": "Utensils" }, { "value": "drop", "label": "Drop" },
          { "value": "thermometer", "label": "Thermometer" }, { "value": "flame", "label": "Flame" }, { "value": "alert", "label": "Alert" },
          { "value": "refresh", "label": "Refresh" }, { "value": "ban", "label": "Ban" }, { "value": "dishwasher", "label": "Dishwasher" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Alleen houten of siliconen spatels" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [
    {
      "name": "Ad landing: problem",
      "blocks": [
        { "type": "rule", "settings": { "icon": "spoon", "title": "Alleen houten of siliconen spatels" } },
        { "type": "rule", "settings": { "icon": "drop", "title": "Voorzichtig afwassen" } },
        { "type": "rule", "settings": { "icon": "thermometer", "title": "Niet te heet" } }
      ]
    }
  ]
}
{% endschema %}
