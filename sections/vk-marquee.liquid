{{ 'vk-section-marquee.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- capture vk_group -%}
  {%- for block in section.blocks -%}
    <span class="vk-marquee__item" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: height: 80 | image_tag: height: 40, class: 'vk-marquee__logo', alt: block.settings.text | default: block.settings.image.alt, loading: 'lazy' }}
      {%- else -%}
        {%- if block.settings.icon != 'none' and section.settings.style == 'ticker' %}{% render 'vk-icon', name: block.settings.icon, size: 18 %}{% endif -%}
        <span class="vk-marquee__text{% if section.settings.style == 'statement' %}{% cycle '', ' is-filled' %}{% endif %}">{{ block.settings.text }}</span>
      {%- endif -%}
    </span>
    <span class="vk-marquee__sep" aria-hidden="true"><svg viewBox="0 0 12 12" width="10" height="10"><path d="M6 0l5.2 3v6L6 12 .8 9V3z" fill="currentColor"/></svg></span>
  {%- endfor -%}
{%- endcapture -%}
<section id="vk-{{ section.id }}" class="vk-section vk-marquee vk-marquee--{{ section.settings.style }} color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}" aria-label="{{ section.settings.label | escape }}">
  <vk-marquee speed="{{ section.settings.speed }}">
    <div class="vk-marquee__track"><div class="vk-marquee__group">{{ vk_group }}</div></div>
  </vk-marquee>
  {%- if section.settings.double_row -%}
    <vk-marquee speed="{{ section.settings.speed }}" direction="right" aria-hidden="true">
      <div class="vk-marquee__track"><div class="vk-marquee__group">{{ vk_group }}</div></div>
    </vk-marquee>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Marquee",
  "tag": "div",
  "class": "vk-marquee-section",
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible label", "default": "Why VOLKARA" },
    { "type": "select", "id": "style", "label": "Style", "default": "ticker", "options": [{ "value": "ticker", "label": "Ticker (small caps)" }, { "value": "statement", "label": "Statement (huge type)" }] },
    { "type": "range", "id": "speed", "label": "Speed", "min": 10, "max": 120, "step": 5, "unit": "px", "default": 40 },
    { "type": "checkbox", "id": "double_row", "label": "Second row (reverse)", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 24 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "PFAS-free" },
      { "type": "select", "id": "icon", "label": "Icon", "default": "none", "options": [
        { "value": "none", "label": "None" }, { "value": "shield", "label": "Shield" }, { "value": "warranty", "label": "Warranty" }, { "value": "induction", "label": "Induction" },
        { "value": "oven", "label": "Oven" }, { "value": "utensils", "label": "Utensils" }, { "value": "dishwasher", "label": "Dishwasher" }, { "value": "truck", "label": "Truck" },
        { "value": "return", "label": "Return" }, { "value": "flame", "label": "Flame" }, { "value": "leaf", "label": "Leaf" }
      ] },
      { "type": "image_picker", "id": "image", "label": "Logo image", "info": "Only use press logos you have permission to show." }
    ] }
  ],
  "presets": [{ "name": "VOLKARA · Marquee", "blocks": [{ "type": "item" }, { "type": "item", "settings": { "text": "Lifetime warranty" } }, { "type": "item", "settings": { "text": "Induction-ready" } }] }]
}
{% endschema %}
