{{ 'vk-section-header.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign vk_messages = section.blocks | where: 'type', 'message'
-%}
<div id="vk-{{ section.id }}" class="vk-announcement color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="vk-container vk-announcement__inner">
    {%- if vk_messages.size > 1 -%}
      <button type="button" class="vk-announcement__nav" data-announce-prev aria-label="{{ 'general.previous' | t }}">{% render 'vk-icon', name: 'chevron-left', size: 14 %}</button>
    {%- endif -%}
    <vk-announcement class="vk-announcement__track" data-interval="{{ section.settings.interval | times: 1000 }}" aria-live="polite">
      {%- for block in section.blocks -%}
        <div class="vk-announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}{% unless forloop.first %} aria-hidden="true"{% endunless %}>
          {%- case block.type -%}
            {%- when 'message' -%}
              {%- if block.settings.icon != 'none' %}{% render 'vk-icon', name: block.settings.icon, size: 14 %}{% endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="vk-announcement__link">{{ block.settings.text }}</a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
            {%- when 'countdown' -%}
              {%- render 'vk-countdown', end: block.settings.end, label: block.settings.label -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </vk-announcement>
    {%- if vk_messages.size > 1 -%}
      <button type="button" class="vk-announcement__nav" data-announce-next aria-label="{{ 'general.next' | t }}">{% render 'vk-icon', name: 'chevron-right', size: 14 %}</button>
    {%- endif -%}
  </div>
</div>
<script src="{{ 'vk-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "aside",
  "class": "vk-announcement-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    { "type": "range", "id": "interval", "label": "Rotate every", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Gratis verzending vanaf €75" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "none", "options": [
          { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "shield", "label": "Shield" },
          { "value": "return", "label": "Return" }, { "value": "flame", "label": "Flame" }, { "value": "sparkle", "label": "Sparkle" }, { "value": "gift", "label": "Gift" }
        ] }
      ]
    },
    {
      "type": "countdown",
      "name": "Countdown",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Only shows while the end date is in the future. Use a real promotion end date that matches your Shopify discount." },
        { "type": "text", "id": "label", "label": "Label", "default": "Introductieaanbieding loopt af over" },
        { "type": "text", "id": "end", "label": "End date & time (ISO)", "info": "Example: 2026-11-30T23:59:00+01:00" }
      ]
    }
  ],
  "presets": [{ "name": "VOLKARA · Announcement bar", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
