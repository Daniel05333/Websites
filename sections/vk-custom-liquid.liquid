{%- render 'vk-section-styles', section: section -%}
<section id="vk-{{ section.id }}" class="vk-section vk-custom-liquid color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="vk-container">{{ section.settings.custom_liquid }}</div>
</section>

{% schema %}
{
  "name": "Custom Liquid",
  "tag": "div",
  "class": "vk-custom-liquid-section",
  "settings": [
    { "type": "liquid", "id": "custom_liquid", "label": "Liquid code", "info": "Add app snippets or other code (for example a review widget or an embed)." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 48 }
  ],
  "presets": [{ "name": "Custom Liquid" }]
}
{% endschema %}
