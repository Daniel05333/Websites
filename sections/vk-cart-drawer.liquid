{{ 'vk-section-cart.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign vk_total_money = cart.total_price | money
  assign vk_empty_primary = 'cart.empty_primary' | t
  assign vk_empty_secondary = 'cart.empty_secondary' | t
-%}
<vk-cart-drawer id="vk-cart-drawer" class="vk-cart-drawer color-scheme-2" role="dialog" aria-modal="true" aria-labelledby="vk-cart-drawer-title" side="right">
  <div class="vk-drawer__overlay"></div>
  <div class="vk-drawer__panel" tabindex="-1">
    <div class="vk-drawer__header">
      <h2 id="vk-cart-drawer-title" class="vk-drawer__title">{{ 'cart.title' | t }} {%- capture vk_count %}{% render 'vk-cart-count', cart: cart %}{% endcapture -%}<span class="vk-cart-drawer__count">{{ vk_count }}</span></h2>
      <button type="button" class="vk-icon-btn vk-icon-btn--plain" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'vk-icon', name: 'close', size: 22 %}</button>
    </div>
    <div class="vk-cart-drawer__content" data-cart-content>
      {%- if cart.item_count > 0 -%}
        <div class="vk-cart-drawer__shipping">{% render 'vk-free-shipping-bar', cart: cart %}</div>
        <div class="vk-drawer__body">
          <vk-cart-items>
            <ul class="vk-lines" role="list">
              {%- for item in cart.items -%}
                {%- render 'vk-cart-line-item', item: item, index: forloop.index -%}
              {%- endfor -%}
            </ul>
          </vk-cart-items>
          {% render 'vk-cart-upsell', cart: cart %}
          {%- if settings.cart_show_note -%}
            <details class="vk-cart-note">
              <summary>{% render 'vk-icon', name: 'gift', size: 16 %}{{ 'cart.note' | t }}</summary>
              <label for="vk-cart-note" class="vk-visually-hidden">{{ 'cart.note' | t }}</label>
              <textarea id="vk-cart-note" class="vk-textarea" name="note" data-cart-note maxlength="500">{{ cart.note }}</textarea>
            </details>
          {%- endif -%}
        </div>
        <div class="vk-drawer__footer vk-cart-drawer__footer">
          {%- render 'vk-cart-insurance', cart: cart -%}
          {%- render 'vk-cart-summary', cart: cart -%}
          <form action="{{ routes.cart_url }}" method="post" class="vk-cart-drawer__checkout">
            <button type="submit" name="checkout" class="vk-btn vk-btn--primary vk-btn--lg vk-btn--block">
              <span class="vk-btn__label">{% render 'vk-icon', name: 'lock', size: 18 %}{{ 'cart.checkout_total' | t: total: vk_total_money }}</span>
            </button>
          </form>
          <button type="button" class="vk-cart-drawer__continue vk-link" data-drawer-close>{{ 'cart.continue' | t }}</button>
          <p class="vk-cart-drawer__trust">{% render 'vk-icon', name: 'lock', size: 13 %}{{ 'cart.secure' | t }}</p>
          {% render 'vk-payment-icons', class: 'vk-cart-drawer__payments' %}
        </div>
      {%- else -%}
        <div class="vk-drawer__body vk-cart-empty">
          <div class="vk-cart-empty__icon">{% render 'vk-icon', name: 'bag', size: 28 %}</div>
          <p class="vk-h3">{{ 'cart.empty' | t }}</p>
          <p class="vk-muted">{{ 'cart.empty_text' | t }}</p>
          <div class="vk-btn-row vk-cart-empty__actions">
            {% render 'vk-button', label: vk_empty_primary, url: '/products/gehamerde-titanium-pan', icon: 'arrow-right' %}
            {% render 'vk-button', label: vk_empty_secondary, url: routes.all_products_collection_url, style: 'secondary' %}
          </div>
          {% render 'vk-free-shipping-bar', cart: cart %}
        </div>
      {%- endif -%}
    </div>
  </div>
</vk-cart-drawer>
<script src="{{ 'vk-cart.js' | asset_url }}" defer="defer"></script>
