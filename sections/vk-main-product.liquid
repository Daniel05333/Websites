{{ 'vk-section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'vk-section-merch.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- liquid
  assign s = section.settings
  assign vk_v = product.selected_or_first_available_variant
  assign vk_form_id = 'vk-product-form-' | append: section.id
  assign vk_price_money = vk_v.price | money
-%}
<section id="vk-{{ section.id }}" class="vk-section vk-pdp color-{{ s.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="vk-container vk-pdp__grid">
    <div class="vk-pdp__media">
      {%- render 'vk-product-gallery', product: product, section_id: section.id, chip: s.gallery_chip, effects: s.gallery_effects -%}
    </div>

    <div class="vk-pdp__info" id="buy">
      <vk-product-info class="vk-pdp__sticky" data-section="{{ section.id }}" data-url="{{ product.url }}">
        <script type="application/json" data-product-json>
          {
            "id": {{ product.id }},
            "options": {{ product.options | json }},
            "variants": [
              {%- for v in product.variants -%}
                { "id": {{ v.id }}, "title": {{ v.title | json }}, "options": {{ v.options | json }}, "price": {{ v.price }}, "compare_at_price": {{ v.compare_at_price | default: 0 }}, "available": {{ v.available }}, "sku": {{ v.sku | json }}, "featured_media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %} }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }
        </script>

        {%- liquid
          # The size pills move into the "single" bundle card when both blocks exist and the bundle block asks for it.
          assign vk_nest_variants = false
          assign vk_size_help = ''
          assign vk_vp_block = section.blocks | where: 'type', 'variant_picker' | first
          assign vk_bp_block = section.blocks | where: 'type', 'bundle_picker' | first
          if vk_vp_block and vk_bp_block and vk_bp_block.settings.nest_variants and product.has_only_default_variant == false
            assign vk_nest_variants = true
            assign vk_size_help = vk_vp_block.settings.size_help
          endif
        -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="vk-pdp__block" {{ block.shopify_attributes }}>{% render block %}</div>

            {%- when 'badge' -%}
              {%- assign vk_badge = block.settings.text | default: product.metafields.custom.badge.value -%}
              {%- if vk_badge != blank -%}<div class="vk-pdp__block vk-pdp__badge" {{ block.shopify_attributes }}>{% render 'vk-badge', text: vk_badge, icon: 'star' %}</div>{%- endif -%}

            {%- when 'title' -%}
              <div class="vk-pdp__block vk-pdp__titles" {{ block.shopify_attributes }}>
                <h1 class="vk-pdp__title">{{ product.title | escape }}</h1>
                {%- assign vk_sub = product.metafields.custom.subtitle.value | default: block.settings.subtitle -%}
                {%- if vk_sub != blank %}<p class="vk-pdp__subtitle">{{ vk_sub }}</p>{% endif -%}
              </div>

            {%- when 'rating' -%}
              <a href="#reviews" class="vk-pdp__block vk-pdp__rating" {{ block.shopify_attributes }}>{% render 'vk-product-rating', product: product, size: 'md' %}</a>

            {%- when 'price' -%}
              <div class="vk-pdp__block vk-pdp__price" {{ block.shopify_attributes }} data-pdp-price>
                {%- render 'vk-price', product: product, variant: vk_v, size: 'lg', dynamic: true -%}
                <p class="vk-pdp__tax vk-small vk-subtle">
                  {%- if cart.taxes_included %}{{ 'products.product.tax_included' | t }}{% endif -%}
                  {%- if shop.shipping_policy.body != blank %} <a href="{{ shop.shipping_policy.url }}" class="vk-link">{{ 'products.product.shipping_calculated' | t }}</a>{% endif -%}
                </p>
              </div>

            {%- when 'text' -%}
              <div class="vk-pdp__block vk-rte vk-pdp__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'usp_tiles' -%}
              <ul class="vk-pdp__block vk-pdp__usps" role="list" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- capture k_icon %}icon_{{ i }}{% endcapture -%}{%- capture k_title %}title_{{ i }}{% endcapture -%}{%- capture k_text %}text_{{ i }}{% endcapture -%}
                  {%- if block.settings[k_title] != blank -%}
                    <li class="vk-pdp__usp"><span class="vk-pdp__usp-icon">{% render 'vk-icon', name: block.settings[k_icon], size: 18 %}</span><span><span class="vk-pdp__usp-title">{{ block.settings[k_title] }}</span><span class="vk-pdp__usp-text">{{ block.settings[k_text] }}</span></span></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant or vk_nest_variants -%}
                <div class="vk-pdp__block" {{ block.shopify_attributes }}>{% render 'vk-variant-options', product: product, section_id: section.id, size_help: block.settings.size_help %}</div>
              {%- endunless -%}

            {%- when 'bundle_picker' -%}
              {%- render 'vk-bundle-picker', block: block, product: product, variant: vk_v, section_id: section.id, nest_variants: vk_nest_variants, size_help: vk_size_help -%}

            {%- when 'countdown' -%}
              {%- if block.settings.end != blank -%}<div class="vk-pdp__block vk-pdp__countdown" {{ block.shopify_attributes }}>{% render 'vk-countdown', end: block.settings.end, label: block.settings.label %}</div>{%- endif -%}

            {%- when 'buy_buttons' -%}
              <div class="vk-pdp__block vk-pdp__buy" {{ block.shopify_attributes }}>
                <vk-product-form class="vk-pdp__form" data-section-id="{{ section.id }}" data-main-form>
                  {%- form 'product', product, id: vk_form_id, class: 'vk-pdp__form-el', novalidate: 'novalidate' -%}
                    <input type="hidden" name="id" value="{{ vk_v.id }}" data-variant-id>
                    <div data-bundle-inputs></div>
                    <div class="vk-pdp__buy-row">
                      {%- if block.settings.show_quantity -%}{%- assign vk_qty_id = vk_form_id | append: '-qty' -%}{% render 'vk-quantity', id: vk_qty_id %}{%- endif -%}
                      <button type="submit" name="add" class="vk-btn vk-btn--primary vk-btn--lg vk-pdp__atc" data-atc data-magnetic="6"{% unless vk_v.available %} disabled{% endunless %}>
                        <span class="vk-btn__label" data-atc-label>
                          {%- if vk_v.available -%}{% render 'vk-icon', name: 'bag', size: 18 %}{{ 'products.product.add_to_bag_price' | t: price: vk_price_money }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
                        </span>
                      </button>
                    </div>
                    {%- if block.settings.show_dynamic_checkout -%}<div class="vk-pdp__dynamic">{{ form | payment_button }}</div>{%- endif -%}
                    <p class="vk-form-message vk-form-message--error" data-form-error role="alert" hidden></p>
                  {%- endform -%}
                </vk-product-form>
                {%- if block.settings.dispatch_text != blank %}<p class="vk-pdp__dispatch vk-small">{% render 'vk-icon', name: 'truck', size: 16 %}{{ block.settings.dispatch_text }}</p>{% endif -%}
              </div>

            {%- when 'gift' -%}
              <div class="vk-pdp__block vk-pdp__gift" {{ block.shopify_attributes }}><span class="vk-pdp__gift-icon">{% render 'vk-icon', name: 'gift', size: 18 %}</span><div><p class="vk-pdp__gift-title">{% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="vk-link">{{ block.settings.title }}</a>{% else %}{{ block.settings.title }}{% endif %}</p><p class="vk-small vk-muted">{{ block.settings.text }}</p></div></div>

            {%- when 'trust' -%}
              <div class="vk-pdp__block vk-pdp__trust" {{ block.shopify_attributes }}>
                <ul role="list">
                  {%- if settings.promise_shipping != blank %}<li>{% render 'vk-icon', name: 'truck', size: 16 %}{{ settings.promise_shipping }}</li>{% endif -%}
                  {%- if settings.promise_trial != blank %}<li>{% render 'vk-icon', name: 'return', size: 16 %}{{ settings.promise_trial }}</li>{% endif -%}
                  {%- if settings.promise_warranty != blank %}<li>{% render 'vk-icon', name: 'shield', size: 16 %}{{ settings.promise_warranty }}</li>{% endif -%}
                  {%- if settings.promise_secure != blank %}<li>{% render 'vk-icon', name: 'lock', size: 16 %}{{ settings.promise_secure }}</li>{% endif -%}
                </ul>
                {%- if block.settings.show_payment_icons -%}
                  <div class="vk-pdp__payments">{% render 'vk-payment-icons' %}</div>
                {%- endif -%}
              </div>

            {%- when 'collapsible_tab' -%}
              <vk-accordion class="vk-pdp__block vk-accordion vk-pdp__tabs" {{ block.shopify_attributes }}>
                <details{% if block.settings.open %} open{% endif %}>
                  <summary>
                    <span class="vk-pdp__tab-title">{% render 'vk-icon', name: block.settings.icon, size: 18 %}{{ block.settings.heading }}</span>
                    <span class="vk-accordion__icon" aria-hidden="true"></span>
                  </summary>
                  <div class="vk-accordion__content vk-rte">
                    {%- case block.settings.source -%}
                      {%- when 'description' -%}{{ product.description }}
                      {%- when 'specs' -%}{% render 'vk-product-specs', product: product %}{{ block.settings.content }}
                      {%- when 'care' -%}{%- if product.metafields.custom.care != blank -%}{{ product.metafields.custom.care | metafield_tag }}{%- else -%}{{ block.settings.content }}{%- endif -%}
                      {%- else -%}{{ block.settings.content }}{%- if block.settings.page != blank %}{{ block.settings.page.content }}{% endif -%}
                    {%- endcase -%}
                  </div>
                </details>
              </vk-accordion>

            {%- when 'complementary' -%}
              <div class="vk-pdp__block vk-pdp__complementary" {{ block.shopify_attributes }}>
                <vk-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ block.settings.limit }}&intent=complementary" data-target="[data-complementary-list]">
                  {%- if recommendations.performed and recommendations.products_count > 0 -%}
                    <p class="vk-eyebrow">{{ block.settings.heading }}</p>
                    <ul class="vk-pdp__comp-list" data-complementary-list role="list">
                      {%- for rec in recommendations.products -%}
                        <li class="vk-pdp__comp">
                          <a href="{{ rec.url }}" class="vk-pdp__comp-media vk-media vk-ratio-square">{%- if rec.featured_image -%}{{ rec.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: rec.title }}{%- else -%}{% render 'vk-placeholder', type: 'product' %}{%- endif -%}</a>
                          <div class="vk-pdp__comp-info"><a href="{{ rec.url }}" class="vk-pdp__comp-title">{{ rec.title | escape }}</a>{% render 'vk-price', product: rec, show_save: false %}</div>
                          <vk-product-form>{%- form 'product', rec -%}<input type="hidden" name="id" value="{{ rec.selected_or_first_available_variant.id }}"><button type="submit" class="vk-icon-btn" aria-label="{{ 'products.card.add_variant' | t: variant: rec.title }}">{% render 'vk-icon', name: 'plus', size: 16 %}</button><p data-form-error hidden></p>{%- endform -%}</vk-product-form>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    <div data-complementary-list></div>
                  {%- endif -%}
                </vk-recommendations>
              </div>

            {%- when 'share' -%}
              <div class="vk-pdp__block vk-pdp__share" {{ block.shopify_attributes }}>
                <button type="button" class="vk-link" data-share-url="{{ shop.url }}{{ product.url }}" data-share-title="{{ product.title | escape }}">{% render 'vk-icon', name: 'share', size: 16 %}<span data-share-label>{{ 'general.share' | t }}</span></button>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </vk-product-info>
    </div>
  </div>

  {%- if s.show_sticky_atc -%}
    {%- render 'vk-sticky-atc', product: product, variant: vk_v, section_id: section.id, form_id: vk_form_id -%}
  {%- endif -%}

  <script type="application/ld+json">{{ product | structured_data }}</script>
</section>
<script src="{{ 'vk-product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product information",
  "tag": "div",
  "class": "vk-pdp-section",
  "settings": [
    { "type": "text", "id": "gallery_chip", "label": "Gallery chip", "default": "Zonder coating" },
    { "type": "checkbox", "id": "gallery_effects", "label": "Gallery effects", "info": "Floating flakes and embers that move away from the pointer; the photo tilts toward it.", "default": true },
    { "type": "checkbox", "id": "show_sticky_atc", "label": "Sticky add-to-cart bar", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "badge", "name": "Badge", "limit": 1, "settings": [{ "type": "text", "id": "text", "label": "Text", "info": "Leave empty to use the product's custom.badge metafield." }] },
    { "type": "title", "name": "Title", "limit": 1, "settings": [{ "type": "text", "id": "subtitle", "label": "Fallback subtitle", "info": "Uses the custom.subtitle metafield when present." }] },
    { "type": "rating", "name": "Rating", "limit": 1, "settings": [{ "type": "paragraph", "content": "Reads reviews.rating and reviews.rating_count metafields from your reviews app." }] },
    { "type": "price", "name": "Price", "limit": 1, "settings": [] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Een titanium koekenpan voor elke dag.</p>" }] },
    { "type": "usp_tiles", "name": "USP tiles", "limit": 1, "settings": [
      { "type": "text", "id": "icon_1", "label": "Icon 1", "default": "shield" }, { "type": "text", "id": "title_1", "label": "Title 1", "default": "PFAS- en PTFE-vrij" }, { "type": "text", "id": "text_1", "label": "Text 1", "default": "Titanium kookoppervlak" },
      { "type": "text", "id": "icon_2", "label": "Icon 2", "default": "warranty" }, { "type": "text", "id": "title_2", "label": "Title 2", "default": "Wettelijke garantie" }, { "type": "text", "id": "text_2", "label": "Text 2", "default": "En 14 dagen bedenktijd" },
      { "type": "text", "id": "icon_3", "label": "Icon 3", "default": "fire-ring" }, { "type": "text", "id": "title_3", "label": "Title 3", "default": "Voor elke warmtebron" }, { "type": "text", "id": "text_3", "label": "Text 3", "default": "Van inductie tot gas" },
      { "type": "text", "id": "icon_4", "label": "Icon 4", "default": "utensils" }, { "type": "text", "id": "title_4", "label": "Title 4", "default": "Geschikt voor metalen spatels" }, { "type": "text", "id": "text_4", "label": "Text 4", "default": "En vaatwasserbestendig" }
    ] },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [{ "type": "text", "id": "size_help", "label": "Size helper", "default": "24 cm: voor elke dag · 28 cm: voor het hele gezin" }] },
    { "type": "bundle_picker", "name": "Bundle tiers", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Honest bundles: savings are calculated from real prices. Tier products are added to the cart as separate items." },
      { "type": "text", "id": "label", "label": "Label", "default": "Kies je set" },
      { "type": "checkbox", "id": "nest_variants", "label": "Show size options inside the first tier", "default": true },
      { "type": "text", "id": "t1_title", "label": "Tier 1 title", "default": "De pan" },
      { "type": "text", "id": "t1_text", "label": "Tier 1 detail", "default": "Eén Forge Pan in jouw maat." },
      { "type": "text", "id": "t2_title", "label": "Tier 2 title", "default": "Pan + deksel" },
      { "type": "text", "id": "t2_text", "label": "Tier 2 detail", "default": "Je Forge Pan met de bijpassende deksel van gehard glas." },
      { "type": "text", "id": "t2_tag", "label": "Tier 2 tag", "default": "Handig" },
      { "type": "range", "id": "t2_pick", "label": "Tier 2: customer picks sizes for this many pans", "min": 0, "max": 4, "step": 1, "default": 0, "info": "0 = use the bundle product or add-on below. 2 or more = one size choice per pan; each pan is added to the cart separately." },
      { "type": "range", "id": "t2_discount", "label": "Tier 2 discount shown (%)", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 0, "info": "Only set this when an automatic discount in Shopify gives exactly this percentage for this many pans. Otherwise the cart price will differ." },
      { "type": "text", "id": "t2_items", "label": "Tier 2 contents", "info": "Comma separated, e.g. 20 cm, 24 cm. Shown when the tier is selected." },
      { "type": "product", "id": "t2_addon", "label": "Tier 2 add-on product", "info": "Added alongside the selected variant; matched by size when possible." },
      { "type": "product", "id": "t2_product", "label": "Tier 2 bundle product", "info": "Use instead of an add-on to offer a second set (e.g. two pans). Overrides the add-on." },
      { "type": "text", "id": "t3_title", "label": "Tier 3 title", "default": "Het Trio" },
      { "type": "text", "id": "t3_text", "label": "Tier 3 detail", "default": "Forge Pans van 20, 24 en 28 cm, €38 minder dan los kopen." },
      { "type": "text", "id": "t3_tag", "label": "Tier 3 tag", "default": "Meeste voordeel" },
      { "type": "range", "id": "t3_pick", "label": "Tier 3: customer picks sizes for this many pans", "min": 0, "max": 4, "step": 1, "default": 0, "info": "0 = use the tier 3 bundle product." },
      { "type": "range", "id": "t3_discount", "label": "Tier 3 discount shown (%)", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 0, "info": "Must match an automatic discount in Shopify." },
      { "type": "text", "id": "t3_items", "label": "Tier 3 contents", "info": "Comma separated, e.g. 20 cm, 24 cm, 28 cm." },
      { "type": "product", "id": "t3_product", "label": "Tier 3 product (bundle product)" }
    ] },
    { "type": "countdown", "name": "Countdown", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Only shown before a real end date that matches your promotion." },
      { "type": "text", "id": "label", "label": "Label", "default": "Introductieaanbieding loopt af over" },
      { "type": "text", "id": "end", "label": "End date & time (ISO)", "info": "e.g. 2026-11-30T23:59:00+01:00" }
    ] },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_quantity", "label": "Quantity selector", "default": true },
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Dynamic checkout buttons", "default": true },
      { "type": "text", "id": "dispatch_text", "label": "Dispatch line", "default": "Verzendkosten en levertijd zie je bij het afrekenen." }
    ] },
    { "type": "gift", "name": "Included / gift", "limit": 1, "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Inbegrepen: digitale kookgids" },
      { "type": "text", "id": "text", "label": "Text", "default": "Onze gids over voorverwarmen, aanbraden en onderhoud." },
      { "type": "url", "id": "link", "label": "Link" }
    ] },
    { "type": "trust", "name": "Trust row", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_payment_icons", "label": "Payment icons", "default": true }] },
    { "type": "collapsible_tab", "name": "Collapsible tab", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Details en specificaties" },
      { "type": "select", "id": "icon", "label": "Icon", "default": "list", "options": [{ "value": "list", "label": "List" }, { "value": "truck", "label": "Truck" }, { "value": "drop", "label": "Drop" }, { "value": "shield", "label": "Shield" }, { "value": "info", "label": "Info" }, { "value": "package", "label": "Package" }] },
      { "type": "select", "id": "source", "label": "Content", "default": "custom", "options": [{ "value": "custom", "label": "Custom text / page" }, { "value": "description", "label": "Product description" }, { "value": "specs", "label": "Specs table (custom.specs)" }, { "value": "care", "label": "Care (custom.care)" }] },
      { "type": "richtext", "id": "content", "label": "Text" },
      { "type": "page", "id": "page", "label": "Page" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ] },
    { "type": "complementary", "name": "Complementary products", "limit": 1, "settings": [
      { "type": "paragraph", "content": "Set complementary products in the Search & Discovery app." },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Past er goed bij" },
      { "type": "range", "id": "limit", "label": "Products", "min": 1, "max": 4, "step": 1, "default": 2 }
    ] },
    { "type": "share", "name": "Share", "limit": 1, "settings": [] }
  ]
}
{% endschema %}
