{{ 'vk-section-pages.css' | asset_url | stylesheet_tag }}
{%- render 'vk-section-styles', section: section -%}
{%- assign s = section.settings -%}
<section id="vk-{{ section.id }}" class="vk-section vk-page color-{{ s.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="vk-container vk-container--narrow">
    <header class="vk-page__head">
      {%- if s.eyebrow != blank %}<p class="vk-eyebrow" data-reveal="fade"><span class="vk-eyebrow__line" aria-hidden="true"></span>{{ s.eyebrow }}</p>{% endif -%}
      <h1 class="vk-h1" data-split>{% if s.heading != blank %}{{ s.heading }}{% else %}{{ page.title | escape }}{% endif %}</h1>
    </header>
    {%- if page.content != blank -%}<div class="vk-rte vk-page__content" data-reveal>{{ page.content }}</div>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="vk-page__contacts" role="list">
        {%- for block in section.blocks -%}
          <li class="vk-page__contact" {{ block.shopify_attributes }} data-reveal>
            <span class="vk-page__contact-icon">{% render 'vk-icon', name: block.settings.icon, size: 18 %}</span>
            <span><span class="vk-mono vk-page__contact-label">{{ block.settings.label }}</span>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.value }}</a>{% else %}{{ block.settings.value }}{% endif %}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page content",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading override", "info": "Leave empty to use the page title." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 160 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    { "type": "contact", "name": "Contact row", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "mail", "options": [{ "value": "mail", "label": "Mail" }, { "value": "clock", "label": "Clock" }, { "value": "map-pin", "label": "Address" }, { "value": "phone", "label": "Phone" }, { "value": "chat", "label": "Chat" }] },
      { "type": "text", "id": "label", "label": "Label", "default": "E-mail" },
      { "type": "text", "id": "value", "label": "Value", "default": "support@volkara.com" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [{ "name": "VOLKARA · Page content" }]
}
{% endschema %}
