{{ 'vk-section-pages.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section id="vk-{{ section.id }}" class="vk-password color-{{ s.color_scheme }}" data-section-id="{{ section.id }}">
  <vk-embers count="50"></vk-embers>
  <div class="vk-password__inner">
    {% render 'vk-logo', size: 'lg' %}
    <p class="vk-eyebrow">{{ s.eyebrow }}</p>
    <h1 class="vk-display vk-password__title" data-split>{{ s.heading }}</h1>
    <p class="vk-lead">{{ s.text }}</p>
    {%- form 'customer', class: 'vk-password__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="vk-form-message vk-form-message--success" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="vk-inline-form">
          <label for="vk-pw-email" class="vk-visually-hidden">{{ 'newsletter.label' | t }}</label>
          <input id="vk-pw-email" type="email" name="contact[email]" class="vk-input" required placeholder="{{ 'newsletter.placeholder' | t }}">
          <button type="submit" class="vk-btn vk-btn--primary"><span class="vk-btn__label">{{ 'password.notify' | t }}</span></button>
        </div>
      {%- endif -%}
    {%- endform -%}
    <button type="button" class="vk-link vk-password__enter" data-drawer-open="vk-password-drawer">{% render 'vk-icon', name: 'lock', size: 16 %}{{ 'password.enter' | t }}</button>
  </div>
  <vk-drawer id="vk-password-drawer" side="bottom" role="dialog" aria-modal="true" aria-label="{{ 'password.enter' | t }}">
    <div class="vk-drawer__overlay"></div>
    <div class="vk-drawer__panel">
      <div class="vk-drawer__header"><p class="vk-drawer__title">{{ 'password.enter' | t }}</p><button type="button" class="vk-icon-btn vk-icon-btn--plain" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'vk-icon', name: 'close', size: 20 %}</button></div>
      <div class="vk-drawer__body">
        {%- form 'storefront_password', class: 'vk-password__login' -%}
          {%- if form.errors %}<p class="vk-form-message vk-form-message--error" role="alert">{{ form.errors | default_errors }}</p>{% endif -%}
          <div class="vk-inline-form">
            <label for="vk-pw" class="vk-visually-hidden">{{ 'password.label' | t }}</label>
            <input id="vk-pw" type="password" name="password" class="vk-input" required autocomplete="current-password" placeholder="{{ 'password.label' | t }}" data-drawer-autofocus>
            <button type="submit" class="vk-btn vk-btn--primary"><span class="vk-btn__label">{{ 'password.submit' | t }}</span></button>
          </div>
        {%- endform -%}
        <p class="vk-small vk-subtle" style="margin-top:1rem">{{ 'password.admin_html' | t: link: '/admin' }}</p>
      </div>
    </div>
  </vk-drawer>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Binnenkort open" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Er wordt iets <em>gesmeed</em>." },
    { "type": "text", "id": "text", "label": "Text", "default": "Laat je e-mailadres achter, dan laten we het je weten zodra we open zijn." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
